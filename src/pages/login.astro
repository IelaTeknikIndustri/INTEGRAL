---
import '@/styles/global.css';

// If already logged in, redirect to /admin
const userCookie = Astro.cookies.get('integral_user');
if (userCookie) {
  return Astro.redirect('/admin');
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/png" href="/logo-integral-7.png" />
    <title>INTEGRAL - Masuk Sistem</title>
  </head>
  <body>
    <div class="login-view-wrapper">
      <!-- Theme Switcher Top Right -->
      <div style="position:absolute; top:20px; right:20px;">
        <button class="btn-theme-toggle" onclick="toggleThemeMode()" title="Ganti Mode Gelap / Terang">
          <span id="login-theme-toggle-icon">🌙</span>
        </button>
      </div>

      <!-- Authentic Login Card -->
      <div class="login-card">
        <img src="https://i.ibb.co/xqkdqtmp/2-1.png" alt="INTEGRAL" class="login-logo" />
        
        <form onsubmit="handleLogin(event)">
          <input
            type="text"
            id="login-user"
            class="inp"
            placeholder="Username Petugas (admin / iela)"
            autocomplete="username"
            required
          />
          <input
            type="password"
            id="login-pass"
            class="inp"
            placeholder="Kata Sandi"
            autocomplete="current-password"
            required
          />

          <div style="display:flex; align-items:center; gap:8px; margin-bottom:16px; padding:0 4px; text-align:left;">
            <input type="checkbox" id="login-remember" checked style="accent-color: var(--accent); cursor:pointer;" />
            <label for="login-remember" style="font-size:12.5px; color:#64748B; font-weight:600; cursor:pointer;">
              Ingat saya di perangkat ini
            </label>
          </div>

          <button type="submit" id="btnLogin" class="btn-login">
            Masuk Sistem
          </button>

          <div id="login-err" style="color:#EF4444; font-size:12px; margin-top:12px; font-weight:600; min-height:16px;"></div>
        </form>

        <div style="margin-top:20px; padding-top:16px; border-top:1px solid var(--border);">
          <a href="/" style="font-size:12px; color:var(--accent); text-decoration:none; font-weight:700;">
            ← Kembali ke Portal Mahasiswa
          </a>
        </div>
      </div>
    </div>

    <script is:inline>
      function initTheme() {
        const saved = localStorage.getItem('integral_theme') || 'light';
        document.documentElement.setAttribute('data-theme', saved);
        const icon = document.getElementById('login-theme-toggle-icon');
        if (icon) icon.innerText = saved === 'dark' ? '☀️' : '🌙';
      }

      function toggleThemeMode() {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('integral_theme', next);
        const icon = document.getElementById('login-theme-toggle-icon');
        if (icon) icon.innerText = next === 'dark' ? '☀️' : '🌙';
      }

      initTheme();

      async function handleLogin(e) {
        e.preventDefault();
        const username = document.getElementById('login-user').value.trim();
        const password = document.getElementById('login-pass').value.trim();
        const btn = document.getElementById('btnLogin');
        const errBox = document.getElementById('login-err');

        btn.disabled = true;
        btn.innerText = 'Memverifikasi...';
        errBox.innerText = '';

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          });
          const data = await res.json();

          if (data.success) {
            window.location.href = '/admin';
          } else {
            errBox.innerText = data.message || 'Username atau password salah!';
          }
        } catch (err) {
          errBox.innerText = 'Koneksi ke server bermasalah.';
        } finally {
          btn.disabled = false;
          btn.innerText = 'Masuk Sistem';
        }
      }
    </script>
  </body>
</html>
