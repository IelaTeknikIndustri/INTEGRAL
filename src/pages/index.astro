        window.kembaliKePilihanKategori = function () {
            var tableView = document.getElementById("buku-table-view");
            var landingView = document.getElementById("buku-landing-view");
            tableView.style.display = "none";
            landingView.style.display = "block";
            landingView.classList.remove("view-enter");
            void landingView.offsetWidth;
            landingView.classList.add("view-enter");
            window.updateKategoriBadges();
        };

        window.buildRakDropdown = function () {
            var raks = {};
            var sourceList = curKatBuku === "Buku Rusak" ? state.bukuRusak : state.bukuPinjam.filter(function (b) { return b.kategori === curKatBuku; });
            sourceList.forEach(function (b) { if (b.rak) raks[b.rak] = true; });

            var opts = '<option value="SEMUA">Lokasi Rak (semua)</option>';
            Object.keys(raks).sort().forEach(function (r) {
                opts += '<option value="' + r + '">' + r + '</option>';
            });
            var sel = document.getElementById("sel-filter-rak-buku");
            if (sel) sel.innerHTML = opts;
        };

        window.filterRakBuku = function (val) {
            filterRakBukuVal = val;
            pageBuku = 1;
            window.renderTabelBuku();
        };

        window.sortBukuKatalog = function (val) {
            sortBukuVal = val;
            pageBuku = 1;
            window.renderTabelBuku();
        };

        window.renderTabelBuku = function () {
            var q = (document.getElementById("cari-buku-inp").value || "").toLowerCase();
            var sourceList = curKatBuku === "Buku Rusak"
                ? (state.bukuRusak || [])
                : state.bukuPinjam.filter(function (b) { return b.kategori === curKatBuku; });

            var list = sourceList.filter(function (b) {
                var matchRak = (filterRakBukuVal === "SEMUA" || b.rak === filterRakBukuVal);
                var matchText = (b.judul.toLowerCase().indexOf(q) > -1 || b.penulis.toLowerCase().indexOf(q) > -1 || String(b.id).indexOf(q) > -1);
                return matchRak && matchText;
            });

            list.sort(function (a, b) {
                if (sortBukuVal === "ID_ASC") return Number(a.id) - Number(b.id);
                if (sortBukuVal === "ID_DESC") return Number(b.id) - Number(a.id);
                if (sortBukuVal === "JUDUL_ASC") return a.judul.localeCompare(b.judul);
                if (sortBukuVal === "TAHUN_DESC") return String(b.tahun).localeCompare(String(a.tahun));
                return 0;
            });

            var total = list.length;
            var start = (pageBuku - 1) * PER_PAGE;
            var paged = list.slice(start, start + PER_PAGE);
            var tbody = document.getElementById("tabel-buku-body");

            document.getElementById("kat-active-subtitle").innerText = "(" + total + " dari " + sourceList.length + " koleksi)";

            if (paged.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:32px; color:var(--text-muted); font-size:13px;">Tidak ada koleksi buku yang cocok.</td></tr>';
            } else {
                tbody.innerHTML = paged.map(function (b) {
                    var stokVal = Number(b.stok) || 0;
                    var stokBadge = stokVal > 0
                        ? '<span class="pill pill-aktif">Stok: ' + stokVal + '</span>'
                        : '<span class="pill pill-terlambat">Habis (0)</span>';

                    return '<tr onclick="window.bukaDetailBukuModal(\'' + b.id + '\')" class="tbl-row-clickable">' +
                        '<td class="td-num">#' + b.id + '</td>' +
                        '<td class="td-name" style="max-width:380px;">' +
                            '<a class="link-buku" style="color:var(--text); text-decoration:none; font-weight:600; cursor:pointer;">' + b.judul + '</a>' +
                        '</td>' +
                        '<td class="td-muted">' + b.penulis + '</td>' +
                        '<td class="td-mono">' + b.tahun + '</td>' +
                        '<td>' + stokBadge + '</td>' +
                        '<td class="td-muted"><span style="display:inline-flex; align-items:center; gap:4px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>' + b.rak + '</span></td>' +
                        '</tr>';
                }).join('');
            }
            document.getElementById("info-p-buku").innerText = 'Menampilkan ' + (total === 0 ? 0 : start + 1) + ' - ' + Math.min(start + PER_PAGE, total) + ' dari ' + total + ' buku';
        };

        window.pageBukuStep = function (step) {
            var sourceList = curKatBuku === "Buku Rusak" ? state.bukuRusak : state.bukuPinjam.filter(function (b) { return b.kategori === curKatBuku; });
            var totalPages = Math.max(1, Math.ceil(sourceList.length / PER_PAGE));
            pageBuku += step;
            if (pageBuku < 1) pageBuku = 1;
            if (pageBuku > totalPages) pageBuku = totalPages;
            window.renderTabelBuku();
        };

        window.bukaDetailBukuModal = function (id) {
            var sourceList = curKatBuku === "Buku Rusak" ? state.bukuRusak : state.bukuPinjam;
            var b = sourceList.find(function (x) { return String(x.id) === String(id); });
            if (!b) return;

            selectedBookDetail = b;
            document.getElementById("mdl-buku-judul").innerText = b.judul;
            document.getElementById("mdl-buku-kat").innerText = b.kategori || curKatBuku;
            document.getElementById("mdl-buku-penulis").innerText = b.penulis || "-";
            document.getElementById("mdl-buku-tahun").innerText = b.tahun || "-";
            document.getElementById("mdl-buku-stok").innerText = "Stok: " + (b.stok || 1);
            document.getElementById("mdl-buku-rak").innerText = b.rak || "Ruang Baca TI";

            window.applyRoleAccess();
            document.getElementById("modalDetailBuku").style.display = "flex";
        };

        window.bukaEditBukuAktif = function () {
            if (!selectedBookDetail) return;
            var b = selectedBookDetail;
            var newJudul = prompt("Ubah Judul Buku:", b.judul);
            if (newJudul === null) return;
            newJudul = newJudul.trim();
            if (!newJudul) { window.showToast("Judul buku tidak boleh kosong!", "error"); return; }
            var newPenulis = prompt("Ubah Penulis / Penyusun:", b.penulis) || "-";
            var newTahun = prompt("Ubah Tahun Terbit:", b.tahun) || String(new Date().getFullYear());
            var newRak = prompt("Ubah Lokasi Rak:", b.rak) || "Ruang Baca TI";

            var updatedData = {
                judul: newJudul,
                penulis: newPenulis,
                tahun: newTahun,
                rak: newRak
            };

            window.showLoading(true);
            if (isGAS) {
                google.script.run
                    .withSuccessHandler(function (res) {
                        window.showLoading(false);
                        if (res.success) {
                            b.judul = newJudul;
                            b.penulis = newPenulis;
                            b.tahun = newTahun;
                            b.rak = newRak;
                            window.showToast(res.message, "success");
                            document.getElementById("modalDetailBuku").style.display = "none";
                            window.renderTabelBuku();
                            window.renderBookGrid();
                        } else {
                            window.showToast("Gagal: " + res.message, "error");
                        }
                    }).withFailureHandler(function (err) {
                        window.showLoading(false);
                        window.showToast("Gagal simpan ke database: " + (err.message || err), "error");
                    }).editBukuKatalog(b.kategori || curKatBuku, b.id, updatedData);
            } else {
                setTimeout(function () {
                    window.showLoading(false);
                    b.judul = newJudul;
                    b.penulis = newPenulis;
                    b.tahun = newTahun;
                    b.rak = newRak;
                    window.showToast("Data buku berhasil diperbarui!", "success");
                    document.getElementById("modalDetailBuku").style.display = "none";
                    window.renderTabelBuku();
                    window.renderBookGrid();
                }, 200);
            }
        };

        window.hapusBukuAktif = function () {
            if (!selectedBookDetail) return;
            if (!state.user || state.user.peran !== "Superadmin") {
                window.showToast("Akses Ditolak: Menghapus koleksi buku memerlukan otorisasi Superadmin!", "error");
                return;
            }
            var b = selectedBookDetail;
            window.askConfirm("Yakin ingin menghapus koleksi '" + b.judul + "' dari database?", function () {
                window.showLoading(true);
                if (isGAS) {
                    google.script.run
                        .withSuccessHandler(function (res) {
                            window.showLoading(false);
                            if (res.success) {
                                var idx = state.bukuPinjam.findIndex(function (x) { return String(x.id) === String(b.id); });
                                if (idx > -1) state.bukuPinjam.splice(idx, 1);
                                document.getElementById("modalDetailBuku").style.display = "none";
                                window.showToast(res.message, "success");
                                window.renderTabelBuku();
                                window.renderBookGrid();
                                window.renderStats();
                                window.updateKategoriBadges();
                            } else {
                                window.showToast("Gagal: " + res.message, "error");
                            }
                        }).withFailureHandler(function (err) {
                            window.showLoading(false);
                            window.showToast("Gagal menghapus: " + (err.message || err), "error");
                        }).hapusBukuKatalog(b.kategori || curKatBuku, b.id);
                } else {
                    setTimeout(function () {
                        window.showLoading(false);
                        var idx = state.bukuPinjam.findIndex(function (x) { return String(x.id) === String(b.id); });
                        if (idx > -1) state.bukuPinjam.splice(idx, 1);
                        document.getElementById("modalDetailBuku").style.display = "none";
                        window.showToast("Buku berhasil dihapus!", "success");
                        window.renderTabelBuku();
                        window.renderBookGrid();
                        window.renderStats();
                        window.updateKategoriBadges();
                    }, 200);
                }
            }, "Hapus Buku");
        };

        window.tandaiBukuKoleksiRusak = function () {
            if (!selectedBookDetail) return;
            var alasan = prompt("Masukkan kondisi kerusakan / catatan:", "Halaman sobek / Sampul rusak");
            if (!alasan) return;

            var b = selectedBookDetail;
            window.showLoading(true);

            if (isGAS) {
                google.script.run
                    .withSuccessHandler(function (res) {
                        window.showLoading(false);
                        if (res.success) {
                            b.stok = Math.max(0, (Number(b.stok) || 1) - 1);
                            if (!state.bukuRusak) state.bukuRusak = [];
                            state.bukuRusak.unshift({
                                id: b.id,
                                judul: b.judul,
                                penulis: b.penulis,
                                tahun: b.tahun,
                                stok: 1,
                                rak: b.rak,
                                kategori: "Buku Rusak",
                                keterangan: alasan
                            });
                            document.getElementById("modalDetailBuku").style.display = "none";
                            window.showToast(res.message, "warning");
                            window.updateKategoriBadges();
                            window.renderTabelBuku();
                        } else {
                            window.showToast("Gagal: " + res.message, "error");
                        }
                    }).withFailureHandler(function (err) {
                        window.showLoading(false);
                        window.showToast("Gagal: " + (err.message || err), "error");
                    }).catatBukuRusakDatabase(b, alasan);
            } else {
                setTimeout(function () {
                    window.showLoading(false);
                    if (!state.bukuRusak) state.bukuRusak = [];
                    state.bukuRusak.unshift({
                        id: b.id,
                        judul: b.judul,
                        penulis: b.penulis,
                        tahun: b.tahun,
                        stok: 1,
                        rak: b.rak,
                        kategori: "Buku Rusak",
                        keterangan: alasan
                    });
                    document.getElementById("modalDetailBuku").style.display = "none";
                    window.showToast("Buku dicatat ke dalam Daftar Buku Rusak!", "warning");
                    window.updateKategoriBadges();
                    window.renderTabelBuku();
                }, 200);
            }
        };

        window.openModalTambahBukuManual = function () {
            var judul = prompt("Masukkan Judul Koleksi Buku Baru:");
            if (!judul || !judul.trim()) return;
            var penulis = prompt("Masukkan Penulis / Penyusun:", "-") || "-";
            var tahun = prompt("Masukkan Tahun Terbit:", String(new Date().getFullYear())) || "-";
            var rak = prompt("Masukkan Lokasi Rak:", "RAK 1 BARIS 1") || "Ruang Baca TI";
            var kat = curKatBuku === "Buku Rusak" ? "Buku Literatur" : curKatBuku;

