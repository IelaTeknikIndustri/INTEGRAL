        };
        window.showToast = function (msg, type) {
            var t = document.getElementById("toast");
            if (!t) { console.log("[TOAST " + type + "]: " + msg); return; }
            t.innerText = msg;
            t.style.background = type === "error" ? "#DC2626" : (type === "success" ? "#059669" : (type === "info" ? "#4F46E5" : "#0F172A"));
            t.style.display = "block";
            clearTimeout(window._toastTimeout);
            window._toastTimeout = setTimeout(function () { t.style.display = "none"; }, 3000);
        };

        /* SISTEM SWITCHER TEMA (DARK / LIGHT MODE) */
        window.initTheme = function () {
            var savedTheme = "light";
            try {
                savedTheme = localStorage.getItem(THEME_STORAGE_KEY) || "light";
            } catch (e) { }
            document.documentElement.setAttribute("data-theme", savedTheme);
            window.updateThemeIcons(savedTheme);
        };

        window.toggleTheme = function () {
            var cur = document.documentElement.getAttribute("data-theme") || "light";
            var nextTheme = (cur === "dark") ? "light" : "dark";
            document.documentElement.setAttribute("data-theme", nextTheme);
            try {
                localStorage.setItem(THEME_STORAGE_KEY, nextTheme);
            } catch (e) { }
            window.updateThemeIcons(nextTheme);
            window.showToast("Mode " + (nextTheme === "dark" ? "Gelap (Dark Mode)" : "Terang (Light Mode)") + " aktif!", "info");
        };

