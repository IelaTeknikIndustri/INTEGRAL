                kategori: kat
            };

            window.showLoading(true);
            if (isGAS) {
                google.script.run
                    .withSuccessHandler(function (res) {
                        window.showLoading(false);
                        if (res.success && res.buku) {
                            state.bukuPinjam.unshift(res.buku);
