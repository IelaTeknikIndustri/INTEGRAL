            document.getElementById("stat-kp").innerText = state.stats.kp || 0;
            document.getElementById("stat-skripsi").innerText = state.stats.skripsi || 0;
            document.getElementById("stat-stok").innerText = state.stats.totalStok || 0;
            document.getElementById("stat-mhs").innerText = state.stats.mahasiswa || 0;
            document.getElementById("stat-aktif").innerText = state.stats.aktif || 0;
