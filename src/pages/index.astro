        window.kirimTestReminderEmail = async function () {
            var emailInput = document.getElementById("reminder-target-email");
            var emailVal = (emailInput ? emailInput.value : "luqmanf667@gmail.com").trim();
            if (!emailVal || emailVal.indexOf("@") === -1) {
                window.showToast("Masukkan alamat email yang valid!", "error");
                return;
            }

            var stage = window.currentReminderStage || 'h-1';
            var stageLabels = {
                'h-1': 'Pengingat H-1 (Jatuh Tempo Besok)',
                'hari-h': 'Pemberitahuan Hari H (Batas Hari Ini)',
                'terlambat': 'Peringatan Terlambat (Overdue & Denda)'
            };

            var statusEl = document.getElementById("reminder-send-status");
            if (statusEl) {
                statusEl.style.display = "block";
                statusEl.innerHTML = '<span style="color:var(--accent);">Memproses pengiriman [' + stageLabels[stage] + '] ke ' + emailVal + '...</span>';
            }

            window.showLoading(true);
            try {
                var res = await fetch("/api/automation/send-reminder", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ targetEmail: emailVal, stage: stage, isTest: true })
                });
                var json = await res.json();
                window.showLoading(false);
                if (statusEl) {
                    if (json.isRealDelivery) {
                        statusEl.innerHTML = '<span style="color:#059669; font-weight:700;">✓ Email Terkirim Nyata [' + stageLabels[stage] + '] ke ' + json.recipient + '!</span>';
                        window.showToast("Email berhasil dikirim ke " + json.recipient, "success");
                    } else {
                        statusEl.innerHTML = '<span style="color:#4F46E5; font-weight:600;">✓ ' + json.message + '</span>';
                        window.showToast("Pratinjau reminder siap untuk " + json.recipient, "info");
                    }
                }
                window.muatPratinjauEmail();
            } catch (err) {
                window.showLoading(false);
                if (statusEl) {
                    statusEl.innerHTML = '<span style="color:#DC2626;">Gagal memproses email: ' + (err.message || err) + '</span>';
                }
                window.showToast("Gagal memproses email reminder.", "error");
            }
        };

