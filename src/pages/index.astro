                    '<div style="background:var(--card-subtle); border:1px dashed #86EFAC; border-radius:10px; padding:12px; color:#15803D; font-size:12px; line-height:1.5;">' +
                    '🏛️ <strong>Instruksi Validasi Yudisium:</strong><br>' +
                    'Silakan datang ke <strong>Meja Sirkulasi Ruang Baca TI UNIROW</strong> untuk pencetakan dan legalisasi fisik Surat Bebas Pustaka resmi oleh Petugas/Asisten Lab.' +
                    '</div>';
            } else {
                bStatus.className = "pill pill-terlambat";
                bStatus.innerText = "BELUM BEBAS ⚠️";
                bInfo.innerHTML = '<div style="color:#991B1B; font-weight:700; margin-bottom:4px;">Masih ada tanggungan:</div>' +
                    '<div style="color:var(--text-muted); font-size:11.5px;">' + (userLoans.length > 0 ? '• ' + userLoans.length + ' buku belum kembali ke rak.<br>' : '') +
                    (totalDenda > 0 ? '• Denda tertunggak: Rp ' + totalDenda.toLocaleString("id-ID") : '') + '</div>';
