        window.eksekusiCekBebas = function () {
            var q = document.getElementById("inp-bebas").value.trim();
            if (!q) {
                window.showToast("Ketikkan NPM mahasiswa!", "error");
                return;
            }
            window.showLoading(true);

            var tampilkanHasil = function (res) {
                lastBebasData = res;
                var box = document.getElementById("hasil-bebas");
                var btnWrap = document.getElementById("btn-cetak-bebas-wrap");
                box.style.display = "block";

                if (res.eligible) {
                    box.style.background = "#DCFCE7";
                    box.style.color = "#166534";
                    box.innerHTML = "✅ <b>BEBAS TANGGUNGAN:</b><br>" + (res.mhs ? res.mhs.nama : q) + " dinyatakan bebas dari tanggungan pustaka.<br>No Surat: <b>" + (res.nomorSurat || ("BP/" + q + "/" + new Date().getFullYear())) + "</b>";
                    btnWrap.style.display = "block";
                } else {
                    box.style.background = "#FEE2E2";
                    box.style.color = "#991B1B";
                    var nominal = Number(res.totalDenda || 0).toLocaleString("id-ID");
                    box.innerHTML = "❌ <b>BELUM BEBAS:</b><br>" + (res.mhs ? res.mhs.nama : q) + " masih memiliki tanggungan peminjaman aktif atau denda tertunggak (Rp " + nominal + ").";
                    btnWrap.style.display = "none";
                }
            };

            if (isGAS) {
                google.script.run
                    .withSuccessHandler(function (res) {
                        window.showLoading(false);
                        tampilkanHasil(res);
                    }).withFailureHandler(function (err) {
                        window.showLoading(false);
                        window.showToast("Gagal memeriksa bebas pustaka: " + (err.message || err), "error");
                    }).verifikasiBebasPustaka(q);
            } else {
                setTimeout(function () {
                    window.showLoading(false);
                    var mhsMatch = state.mahasiswa.find(function (m) {
                        return m.npm.toLowerCase().indexOf(q.toLowerCase()) > -1 || m.nama.toLowerCase().indexOf(q.toLowerCase()) > -1;
                    });
                    var activeLoans = state.riwayat.filter(function (r) {
                        return (r.mahasiswa.toLowerCase().indexOf(q.toLowerCase()) > -1 || (mhsMatch && r.mahasiswa.toLowerCase().indexOf(mhsMatch.nama.toLowerCase()) > -1)) && r.status !== "dikembalikan";
                    });
                    var totalDenda = 0;
                    activeLoans.forEach(function (l) {
                        if (l.denda && l.denda !== "-") totalDenda += Number(l.denda.replace(/[^0-9]/g, "")) || 0;
                    });
                    var isEligible = activeLoans.length === 0 && totalDenda === 0;
                    tampilkanHasil({
                        eligible: isEligible,
                        mhs: mhsMatch || { nama: "MAHASISWA " + q, npm: q, angkatan: "2023", status: "Aktif" },
                        nomorSurat: "BP/" + q + "/" + new Date().getFullYear() + ("0" + (new Date().getMonth() + 1)).slice(-2) + ("0" + new Date().getDate()).slice(-2),
                        totalDenda: totalDenda
                    });
                }, 250);
            }
        };

        

