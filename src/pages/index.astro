            var userLoans = state.riwayat.filter(function (r) {
                var matchUser = (r.mahasiswa.toLowerCase().indexOf(stu.nama.toLowerCase()) > -1 || (stu.npm && r.mahasiswa.indexOf(stu.npm) > -1));
                return matchUser && r.status !== "dikembalikan";
            });

            var boxLoans = document.getElementById("stu-box-active-loans");
            document.getElementById("stu-badge-loan-count").innerText = userLoans.length + " Judul";

            if (userLoans.length === 0) {
                boxLoans.innerHTML = '<div style="text-align:center; padding:16px; color:var(--text-muted); font-size:12px;">✨ Tidak ada pinjaman buku aktif.</div>';
            } else {
                boxLoans.innerHTML = userLoans.map(function (item) {
                    var isLate = item.status === "terlambat";
                    var badge = isLate
                        ? '<span class="pill pill-terlambat" style="font-size:10px;">⚠️ Terlambat (' + item.denda + ')</span>'
                        : '<span class="pill pill-dikembalikan" style="font-size:10px;">⏱️ Aktif</span>';
                    return '<div class="active-loan-student-item">' +
                        '<div style="font-weight:700; font-size:12.5px; color:var(--text); margin-bottom:4px;">' + item.detailBuku.split(" | RAK: ")[0] + '</div>' +
                        '<div style="display:flex; justify-content:space-between; align-items:center; font-size:11px; color:var(--text-muted);">' +
                        '<span>Batas: <strong style="color:var(--accent);">' + item.batasKembali + '</strong></span>' + badge +
                        '</div>' +
                        '</div>';
                }).join('');
            }

            var totalDenda = 0;
            userLoans.forEach(function (l) {
                if (l.denda && l.denda !== "-") totalDenda += Number(l.denda.replace(/[^0-9]/g, "")) || 0;
            });

            var bStatus = document.getElementById("stu-badge-bebas-status");
            var bInfo = document.getElementById("stu-box-bebas-info");

            if (userLoans.length === 0 && totalDenda === 0) {
                bStatus.className = "pill pill-dikembalikan";
