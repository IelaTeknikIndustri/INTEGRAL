        window.bukaKatalogKategori = function (kat) {
            curKatBuku = kat;
            pageBuku = 1;
            filterRakBukuVal = "SEMUA";

            var landingView = document.getElementById("buku-landing-view");
            var tableView = document.getElementById("buku-table-view");
            landingView.style.display = "none";
            tableView.style.display = "block";
            tableView.classList.remove("view-enter");
            void tableView.offsetWidth;
            tableView.classList.add("view-enter");

            var iconEl = document.getElementById("kat-active-icon");
            var titEl = document.getElementById("kat-active-title");

            titEl.innerText = kat;
            if (kat === "Buku Literatur") iconEl.innerText = "📚";
            else if (kat === "Laporan KP") iconEl.innerText = "📝";
            else if (kat === "Skripsi") iconEl.innerText = "🎓";
            else iconEl.innerText = "⚠️";

            window.buildRakDropdown();
            window.renderTabelBuku();
