            var cKp = state.bukuPinjam.filter(function (b) { return b.kategori === "Laporan KP"; }).length;
            var cSkripsi = state.bukuPinjam.filter(function (b) { return b.kategori === "Skripsi"; }).length;
            var cRusak = state.bukuRusak ? state.bukuRusak.length : 0;

