    <script is:inline>

        /* === INTEGRAL ASTRO & SUPABASE API BRIDGE === */
        window.google = {
            script: {
                run: {
                    withSuccessHandler: function (cb) {
                        var o = Object.create(this);
                        o._success = cb;
                        return o;
                    },
                    withFailureHandler: function (cb) {
                        var o = Object.create(this);
                        o._failure = cb;
                        return o;
                    },
                    _call: async function (url, method, data) {
                        try {
                            var opts = {
                                method: method || 'GET',
                                headers: { 'Content-Type': 'application/json' }
                            };
                            if (data) opts.body = JSON.stringify(data);
                            var res = await fetch(url, opts);
                            var json = await res.json();
                            if (this._success) this._success(json);
                            return json;
                        } catch (err) {
                            if (this._failure) this._failure(err);
                            else console.error('API call error:', err);
                        }
                    },
                    login: function (u, p) {
                        return this._call('/api/auth/login', 'POST', { username: u, password: p });
                    },
                    getInitialData: function () {
                        return this._call('/api/initial-data', 'GET');
                    },
                    simpanPeminjamanBaru: function (nama, listBukuIds) {
                        return this._call('/api/loans/create', 'POST', { namaPeminjam: nama, selectedBukuIds: listBukuIds });
                    },
                    kembalikanBukuRow: function (idTrx, namaMhs) {
                        return this._call('/api/loans/return', 'POST', { idTransaksi: idTrx, namaMhs: namaMhs });
                    },
                    aksiBukuIndividual: function (idTrx, idxBuku, aksi, namaMhs) {
                        return this._call('/api/loans/action', 'POST', { idTransaksi: idTrx, idxBuku: idxBuku, aksi: aksi, namaMhs: namaMhs });
                    },
                    verifikasiBebasPustaka: function (q) {
                        return this._call('/api/clearance/check', 'POST', { query: q });
                    },
                    konsultasiAiMahasiswa: function (q, npm) {
                        var self = this;
                        fetch('/api/ai/chat', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ message: q, npm: npm })
                        }).then(function (r) { return r.json(); })
                        .then(function (res) {
                            if (self._success) {
                                self._success({ success: res.success, jawaban: res.reply || res.message });
                            }
                        }).catch(function (err) {
                            if (self._failure) self._failure(err);
                        });
                    },
                    tambahBukuBaru: function (kategori, bukuData) {
                        bukuData.kategori = kategori;
                        return this._call('/api/collections/create', 'POST', bukuData);
                    },
                    editBukuRow: function (id, judul, penulis, tahun, kat, rak) {
                        return this._call('/api/collections/update', 'POST', { id: id, judul: judul, penulis: penulis, tahun: tahun, kategori: kat, rak: rak });
                    },
                    hapusBukuItem: function (id, judul) {
                        return this._call('/api/collections/delete', 'POST', { id: id, judul: judul });
                    },
                    catatBukuRusak: function (id, judul, kat, catatan) {
                        return this._call('/api/collections/report-damage', 'POST', { id: id, judul: judul, kategori: kat, catatan: catatan });
                    },
                    tambahMahasiswaBaru: function (mhsData) {
                        return this._call('/api/students/create', 'POST', mhsData);
                    },
                    ambilTemplateSurat: function () {
                        return this._call('/api/clearance/template', 'GET');
                    },
                    simpanTemplateSurat: function (tpl) {
                        return this._call('/api/clearance/template', 'POST', { template: tpl });
                    },
                    perbaruiDendaOtomatis: function () {
                        var self = this;
                        setTimeout(function () {
                            if (self._success) self._success({ success: true, message: "Kalkulasi denda selesai disinkronkan!" });
                        }, 400);
                    },
                    bersihkanDataGandaSemua: function () {
                        var self = this;
                        setTimeout(function () {
                            if (self._success) self._success({ success: true, message: "Integritas basis data terverifikasi rapi!" });
                        }, 400);
                    },
                    kirimNotifikasiOtomatis: function () {
                        var self = this;
                        setTimeout(function () {
                            if (self._success) self._success({ success: true, message: "Notifikasi pengingat via email berhasil dikirim!" });
                        }, 500);
                    },
                    cekStatusTriggerOtomatis: function () {
                        var self = this;
                        setTimeout(function () {
                            if (self._success) self._success({ success: true, aktif: true });
                        }, 200);
                    },
                    aktifkanTriggerOtomatis: function () {
                        var self = this;
                        setTimeout(function () {
                            if (self._success) self._success({ success: true, message: "Otomatisasi pengingat jam 08:00 WIB aktif!" });
                        }, 200);
                    },
                    nonaktifkanTriggerOtomatis: function () {
                        var self = this;
                        setTimeout(function () {
                            if (self._success) self._success({ success: true, message: "Otomatisasi pengingat dinonaktifkan." });
                        }, 200);
                    },
                    eksekusiManualTrigger: function () {
                        var self = this;
                        setTimeout(function () {
                            if (self._success) self._success({ success: true, message: "Siklus pengingat berhasil dijalankan!" });
                        }, 500);
                    },
                    importDataCsvDatabase: function (targetSheet, txt) {
                        var self = this;
                        setTimeout(function () {
                            if (self._success) self._success({ success: true, message: "Data master berhasil diimpor!" });
                        }, 400);
                    }
                }
            }
        };
