                rows.push([idx + 1, '"' + m.nama.replace(/"/g, '""') + '"', "'" + m.npm, m.email, m.angkatan, m.status, "'" + m.noHp]);
            });
            window.unduhCsv(rows, "Direktori_Mahasiswa_INTEGRAL.csv");
        };

        window.exportCsvRiwayat = function () {
            var rows = [["No", "Mahasiswa", "Tgl Pinjam", "Batas Kembali", "Status", "Denda", "Detail Buku"]];
            state.riwayat.forEach(function (r, idx) {
                rows.push([idx + 1, '"' + r.mahasiswa.replace(/"/g, '""') + '"', r.tglPinjam, r.batasKembali, r.status, r.denda, '"' + r.detailBuku.replace(/"/g, '""') + '"']);
            });
            window.unduhCsv(rows, "Riwayat_Peminjaman_INTEGRAL.csv");
        };

        window.unduhCsv = function (rows, filename) {
            var link = document.createElement("a");
            link.setAttribute("href", encodeURI("data:text/csv;charset=utf-8,\uFEFF" + rows.map(function (e) { return e.join(","); }).join("\n")));
            link.setAttribute("download", filename);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        // UI feedback helpers showLoading & showToast initialized at top of script

        document.addEventListener("DOMContentLoaded", function () {
            window.initTheme();

        function updateLiveClock() {
            var now = new Date();
            var hours = String(now.getHours()).padStart(2, '0');
            var minutes = String(now.getMinutes()).padStart(2, '0');
            var seconds = String(now.getSeconds()).padStart(2, '0');
            var clockStr = hours + ":" + minutes + ":" + seconds;
            var timeEl = document.getElementById("dashboard-clock-time");
            var headerClockEl = document.getElementById("header-clock");
            if (timeEl) timeEl.innerText = clockStr;
            if (headerClockEl) headerClockEl.innerText = clockStr + " WIB";
            
            var dateEl = document.getElementById("dashboard-clock-date");
            if (dateEl) {
                var days = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
                var months = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                dateEl.innerText = days[now.getDay()] + ", " + now.getDate() + " " + months[now.getMonth()] + " " + now.getFullYear();
            }
        }
        setInterval(updateLiveClock, 1000);
        updateLiveClock();

            var clockDate = document.getElementById("dashboard-clock-date");
            var clockTime = document.getElementById("dashboard-clock-time");
            if (clockDate && clockTime) {
                var dateFormatter = new Intl.DateTimeFormat("id-ID", {
                    timeZone: "Asia/Jakarta",
                    weekday: "long",
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                });
                var timeFormatter = new Intl.DateTimeFormat("id-ID", {
                    timeZone: "Asia/Jakarta",
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit",
                    hourCycle: "h23"
                });
                var updateDashboardClock = function () {
                    var now = new Date();
                    clockDate.textContent = dateFormatter.format(now);
                    clockTime.textContent = timeFormatter.format(now);
                    clockTime.dateTime = now.toISOString();
                };
                updateDashboardClock();
                window.setInterval(updateDashboardClock, 1000);
            }
            var actionsMenu = document.querySelector(".actions-menu");
            if (actionsMenu) {
                document.addEventListener("click", function (event) {
                    if (!actionsMenu.contains(event.target)) {
                        actionsMenu.open = false;
                    } else if (event.target.closest(".action-menu-item")) {
                        actionsMenu.open = false;
                    }
                });
                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape" && actionsMenu.open) {
                        actionsMenu.open = false;
                        actionsMenu.querySelector("summary").focus();
                    }
                });
            }
            try {
                var saved = localStorage.getItem(STORAGE_KEY);
                if (saved) {
                    var user = JSON.parse(saved);
                    if (user && user.username) {
                        state.user = user;
                        document.getElementById("login-view").style.display = "none";
                        if (user.peran === "Mahasiswa") {
                            document.getElementById("main-view").style.display = "none";
                            document.getElementById("student-view").style.display = "block";
                            window.loadServerData();
                        } else {
                            document.getElementById("student-view").style.display = "none";
                            document.getElementById("main-view").style.display = "flex";
                            document.getElementById("user-display-name").innerText = user.nama;
                            window.applyRoleAccess();
                            window.loadServerData();
                        }
                    }
                }
            } catch (e) { }
        });
    </script>
</body>

</html>