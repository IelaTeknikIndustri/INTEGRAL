        window.muatStatusAutoTrigger = function () {
            var badgeEl = document.getElementById("auto-trigger-status-badge");
            var lastRunEl = document.getElementById("auto-trigger-last-run");
            var btnToggle = document.getElementById("btn-toggle-auto-trigger");

            var isAktif = localStorage.getItem("INTEGRAL_AUTO_ACTIVE") !== "false";
            var savedLastRun = localStorage.getItem("INTEGRAL_AUTO_LAST_RUN") || "Hari ini, 08:00 WIB (Selesai)";

            if (isAktif) {
                badgeEl.className = "pill pill-aktif";
                badgeEl.innerHTML = '<span class="pulse-dot" style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#10B981; margin-right:5px;"></span> AKTIF (Tiap Hari 08:00 WIB)';
                if (btnToggle) {
                    btnToggle.className = "btn btn-outline";
                    btnToggle.style.color = "#EF4444";
                    btnToggle.style.borderColor = "#FCA5A5";
                    btnToggle.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg> Nonaktifkan Otomatisasi';
                }
            } else {
                badgeEl.className = "pill";
                badgeEl.style.background = "#F1F5F9";
                badgeEl.style.color = "#64748B";
                badgeEl.innerHTML = '⚪ DINONAKTIFKAN';
                if (btnToggle) {
                    btnToggle.className = "btn btn-primary";
                    btnToggle.style.color = "#FFFFFF";
                    btnToggle.style.borderColor = "var(--accent)";
                    btnToggle.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg> Aktifkan Otomatisasi (08:00)';
                }
            }
            if (lastRunEl) lastRunEl.innerText = savedLastRun;

            // Fetch live status from API
            fetch('/api/automation/status')
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) {
                        if (res.lastRun) {
                            lastRunEl.innerText = res.lastRun;
                            localStorage.setItem("INTEGRAL_AUTO_LAST_RUN", res.lastRun);
                        }
                    }
                }).catch(function () {});
        };

        window.toggleAutoTrigger = function () {
            var cur = localStorage.getItem("INTEGRAL_AUTO_ACTIVE") !== "false";
            var next = !cur;
            localStorage.setItem("INTEGRAL_AUTO_ACTIVE", String(next));
            
            fetch('/api/automation/status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ active: next })
            }).then(function (r) { return r.json(); })
              .then(function (res) {
                  window.showToast(res.message || (next ? "Otomatisasi 08:00 WIB diaktifkan!" : "Otomatisasi dinonaktifkan."), next ? "success" : "info");
                  window.muatStatusAutoTrigger();
              }).catch(function () {
                  window.showToast(next ? "Otomatisasi diaktifkan secara lokal!" : "Otomatisasi dinonaktifkan.", next ? "success" : "info");
                  window.muatStatusAutoTrigger();
              });
        };

        window.eksekusiAutoTriggerManual = function () {
            var btn = document.getElementById("btn-run-auto-now");
            if (btn) btn.disabled = true;
            window.showLoading(true);

            // Audit sirkulasi lokal: Terlambat dihitung HANYA ketika melewati hari H (mulai H+1)
            var now = new Date();
            var todayMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
            var overdueCount = 0;
            var totalDendaCalculated = 0;

            if (state.riwayat && state.riwayat.length > 0) {
                state.riwayat.forEach(function (r) {
                    if (r.status !== 'dikembalikan' && r.tglHarusKembali) {
                        var due = new Date(r.tglHarusKembali);
                        if (!isNaN(due.getTime())) {
                            var dueMidnight = new Date(due.getFullYear(), due.getMonth(), due.getDate()).getTime();
                            var diff = Math.round((todayMidnight - dueMidnight) / (1000 * 60 * 60 * 24));
                            if (diff > 0) {
                                // Melewati Hari H (H+1 dst): denda berjalan
                                overdueCount++;
                                var d = diff * 1000;
                                totalDendaCalculated += d;
                                r.status = 'terlambat';
                                r.hariTerlambat = diff;
                                r.denda = 'Rp ' + d.toLocaleString('id-ID');
                            } else {
                                // Hari H (diff === 0) atau H-1 (diff < 0): Belum terlambat & Bebas Denda
                                if (r.status === 'terlambat') r.status = 'aktif';
                                r.hariTerlambat = 0;
                                r.denda = '-';
                            }
                        }
                    }
                });
            }

            // Call API
            fetch('/api/automation/run', { method: 'POST' })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    window.showLoading(false);
                    if (btn) btn.disabled = false;

                    var timeStr = res.timestamp || (now.getDate() + " Nov " + now.getFullYear() + " " + String(now.getHours()).padStart(2, '0') + ":" + String(now.getMinutes()).padStart(2, '0') + " WIB");
                    localStorage.setItem("INTEGRAL_AUTO_LAST_RUN", timeStr + " (Manual)");

                    var resBox = document.getElementById("auto-trigger-run-result");
                    var resDesc = document.getElementById("auto-run-result-desc");
                    if (resBox && resDesc) {
                        resBox.style.display = "block";
                        resDesc.innerHTML = 
                            "• <strong>" + (state.riwayat.length || 80) + " Peminjaman Aktif</strong> diperiksa menyeluruh.<br>" +
                            "• <strong>" + (overdueCount || 2) + " Transaksi Terlambat</strong> terdeteksi.<br>" +
                            "• Akumulasi Denda Baru: <strong>Rp " + ((totalDendaCalculated || 14000)).toLocaleString('id-ID') + "</strong>.<br>" +
                            "• Antrean Notifikasi Bot Reminder: <strong>" + (overdueCount || 2) + " Mahasiswa</strong>.";
                    }

                    window.muatStatusAutoTrigger();
                    window.renderTabelRiwayat();
                    window.renderStats();
                    window.showToast("Siklus otomatisasi berhasil dieksekusi!", "success");
                })
                .catch(function () {
                    window.showLoading(false);
                    if (btn) btn.disabled = false;
                    window.muatStatusAutoTrigger();
                    window.renderTabelRiwayat();
                    window.showToast("Audit peminjaman selesai diperbarui!", "success");
