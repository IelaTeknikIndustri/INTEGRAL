---
import '@/styles/global.css';
import { supabase } from '@/lib/supabase';

// Fetch Catalog items from Supabase
const { data: collections = [] } = await supabase
  .from('collections')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(150);

const { count: totalCollections } = await supabase.from('collections').select('*', { count: 'exact', head: true });
const { count: totalLit } = await supabase.from('collections').select('*', { count: 'exact', head: true }).eq('kategori', 'Buku Literatur');
const { count: totalKp } = await supabase.from('collections').select('*', { count: 'exact', head: true }).eq('kategori', 'Laporan KP');
const { count: totalSkripsi } = await supabase.from('collections').select('*', { count: 'exact', head: true }).eq('kategori', 'Skripsi');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/png" href="/logo-integral-7.png" />
    <title>INTEGRAL - Portal Mahasiswa TI UNIROW</title>
  </head>
  <body>
    <!-- TOPBAR MAHASISWA (Authentic from index.html line 1578) -->
    <header class="student-topbar">
      <div style="display:flex; align-items:center; gap:10px;">
        <img src="https://i.ibb.co/xqkdqtmp/2-1.png" alt="INTEGRAL" style="height:38px; object-fit:contain;" />
        <div style="border-left:2px solid var(--border); padding-left:10px;">
          <span style="font-size:13px; font-weight:800; color:var(--text);">Portal Mahasiswa TI</span>
        </div>
      </div>

      <div style="display:flex; align-items:center; gap:10px;">
        <button class="btn-theme-toggle" onclick="toggleThemeMode()" title="Ganti Mode Gelap / Terang">
          <span id="theme-toggle-icon">🌙</span>
        </button>
        <div style="text-align:right;" class="hidden sm:block">
          <div style="font-size:13px; font-weight:800; color:var(--text);">Rekan Mahasiswa</div>
          <div style="font-size:10.5px; color:var(--text-muted); font-weight:600;">S-1 Teknik Industri</div>
        </div>
        <div style="width:38px; height:38px; border-radius:12px; background:linear-gradient(135deg, #4F46E5, #9333EA); color:white; font-weight:800; display:flex; align-items:center; justify-content:center; font-size:15px;">
          M
        </div>
        <a href="/login" class="btn btn-ghost" style="padding:7px 12px; font-size:12px; text-decoration:none;" title="Masuk Staf">
          🔑 <span class="hidden sm:inline">Staf</span>
        </a>
      </div>
    </header>

    <div style="max-w:1200px; margin:0 auto; padding:20px 16px;">
      
      <!-- HERO BANNER MAHASISWA (Authentic from index.html line 1607) -->
      <div class="hero-banner-student">
        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:10px;">
          <span style="background:rgba(255,255,255,0.18); padding:3px 10px; border-radius:999px; font-size:10.5px; font-weight:700;">
            S-1 Teknik Industri UNIROW
          </span>
          <span style="background:rgba(255,255,255,0.18); padding:3px 10px; border-radius:999px; font-size:10.5px; font-weight:700;">
            Mahasiswa Aktif
          </span>
        </div>
        <h2 style="font-size:22px; font-weight:800; margin-bottom:6px;">
          Halo, Rekan Mahasiswa! 👋
        </h2>
        <p style="font-size:13px; color:#C4B5FD; line-height:1.5; max-width:640px;">
          Pantau masa pinjam buku, cek kelayakan bebas pustaka yudisium, dan telusuri {totalCollections || 977} referensi Tugas Akhir langsung dari ponsel Anda.
        </p>
      </div>

      <!-- STATUS CARDS (Pinjaman Berjalan & Bebas Pustaka) -->
      <div class="student-status-grid">
        <div class="student-card-status">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <div style="font-size:13.5px; font-weight:800; color:var(--text); display:flex; align-items:center; gap:6px;">
              <span>📖</span><span>Pinjaman Buku Berjalan</span>
            </div>
            <span class="pill pill-aktif" id="badge-loan-count">Cek Mandiri</span>
          </div>
          <p style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">
            Ketik NPM kamu untuk melihat buku yang sedang dipinjam:
          </p>
          <div style="display:flex; gap:8px;">
            <input type="text" id="npmLoanInput" class="inp" placeholder="Ketik NPM (misal: 1411230105)..." style="margin-bottom:0;" />
            <button onclick="checkMyLoans()" id="btnCheckLoans" class="btn btn-primary" style="white-space:nowrap;">Cek</button>
          </div>
          <div id="boxLoanResult" style="margin-top:12px; display:none;"></div>
        </div>

        <div class="student-card-status">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <div style="font-size:13.5px; font-weight:800; color:var(--text); display:flex; align-items:center; gap:6px;">
              <span>📜</span><span>Status Bebas Pustaka</span>
            </div>
            <span class="pill pill-selesai">Syarat Yudisium</span>
          </div>
          <p style="font-size:12px; color:var(--text-muted); margin-bottom:12px; line-height:1.5;">
            Surat Keterangan resmi bebas tanggungan untuk pendaftaran Yudisium &amp; Wisuda ber-QR Code valid.
          </p>
          <button onclick="openModalClearance()" class="btn btn-success" style="width:100%; justify-content:center;">
            📜 Periksa Status Bebas Pustaka
          </button>
        </div>
      </div>

      <!-- LAYANAN CEPAT RUANG BACA (Authentic 4 button row from line 1654) -->
      <div style="font-size:14px; font-weight:800; color:var(--text); margin-bottom:12px; display:flex; align-items:center; gap:6px;">
        <span>⚡</span><span>Layanan Cepat Ruang Baca</span>
      </div>
      <div class="quick-nav-student-row">
        <a href="#katalog" class="quick-student-btn" style="text-decoration:none;">
          <div style="font-size:24px;">📚</div>
          <div style="font-size:12px; font-weight:700; color:var(--text);">Cari Buku / KP</div>
        </a>
        <div class="quick-student-btn" onclick="openModalChat()">
          <div style="font-size:24px;">🤖</div>
          <div style="font-size:12px; font-weight:700; color:var(--text);">Asisten Riset AI</div>
        </div>
        <div class="quick-student-btn" onclick="openModalDenah()">
          <div style="font-size:24px;">📍</div>
          <div style="font-size:12px; font-weight:700; color:var(--text);">Lokasi Rak</div>
        </div>
        <div class="quick-student-btn" onclick="openModalClearance()">
          <div style="font-size:24px;">📋</div>
          <div style="font-size:12px; font-weight:700; color:var(--text);">Bebas Pustaka</div>
        </div>
      </div>

      <!-- KATALOG OPAC (Authentic line 1683) -->
      <div id="katalog" style="margin-top:28px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; flex-wrap:wrap; gap:8px;">
          <div style="font-size:16px; font-weight:800; color:var(--text);">🔍 Katalog Terbuka Ruang Baca (OPAC)</div>
          <div style="font-size:12px; color:var(--text-muted);">{totalCollections} Koleksi Terdata</div>
        </div>

        <div style="margin-bottom:12px;">
          <input type="text" id="opacSearch" class="inp" placeholder="Cari judul buku, penulis, topik skripsi, nama perusahaan KP..." />
        </div>

        <!-- Filter Tabs -->
        <div class="filter-tabs" style="margin-bottom:16px;">
          <button class="tab-btn active" onclick="filterCategory('all', this)">Semua Koleksi ({totalCollections})</button>
          <button class="tab-btn" onclick="filterCategory('Buku Literatur', this)">📖 Buku Literatur ({totalLit})</button>
          <button class="tab-btn" onclick="filterCategory('Laporan KP', this)">🏭 Laporan KP ({totalKp})</button>
          <button class="tab-btn" onclick="filterCategory('Skripsi', this)">📜 Skripsi ({totalSkripsi})</button>
        </div>

        <!-- Book Grid -->
        <div class="catalog-student-grid" id="catalogGrid">
          {collections.map((item) => {
            const isAvail = item.stok > 0;
            return (
              <div class="book-student-card"
                   data-kategori={item.kategori}
                   data-search={`${item.judul} ${item.penulis} ${item.rak}`.toLowerCase()}>
                <div>
                  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <span class="pill" style="background:#EEF2FF; color:#4338CA; font-size:10px;">
                      {item.kategori}
                    </span>
                    <span style={`font-size:11px; font-weight:700; color:${isAvail ? '#16A34A' : '#DC2626'};`}>
                      {isAvail ? `Stok: ${item.stok}` : 'Dipinjam'}
                    </span>
                  </div>

                  <h3 style="font-size:13.5px; font-weight:800; color:var(--text); line-height:1.4; margin-bottom:8px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                    {item.judul}
                  </h3>

                  <div style="font-size:11.5px; color:var(--text-muted); line-height:1.5;">
                    <div>Penulis: <strong style="color:var(--text);">{item.penulis || '-'}</strong></div>
                    <div>Tahun: <strong style="color:var(--text);">{item.tahun_terbit || '-'}</strong></div>
                  </div>
                </div>

                <div style="margin-top:14px; padding-top:10px; border-top:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; font-size:11px;">
                  <span class="pill" style="background:var(--card-subtle); color:var(--text);">📍 {item.rak}</span>
                  <span style="color:var(--text-muted); font-family:monospace;">#{item.id}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>

    </div>

    <!-- MODAL BEBAS PUSTAKA -->
    <div id="modalClearance" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.6); z-index:99999; align-items:center; justify-content:center; padding:16px;">
      <div style="background:var(--surface); color:var(--text); border:1px solid var(--border); border-radius:22px; width:100%; max-width:440px; padding:24px; position:relative; box-shadow:0 20px 40px rgba(0,0,0,0.3);">
        <button onclick="closeModalClearance()" style="position:absolute; top:16px; right:16px; background:none; border:none; font-size:18px; color:var(--text-muted); cursor:pointer;">&times;</button>
        <div style="text-align:center; margin-bottom:16px;">
          <div style="font-size:32px; margin-bottom:4px;">📜</div>
          <h3 style="font-size:16px; font-weight:800;">Verifikasi Bebas Ruang Baca</h3>
          <p style="font-size:12px; color:var(--text-muted); margin-top:2px;">Syarat pendaftaran Yudisium S-1 Teknik Industri</p>
        </div>
        <form onsubmit="handleCheckClearance(event)">
          <input type="text" id="clearanceNpmInput" class="inp" placeholder="Masukkan 10 digit NPM kamu..." required />
          <button type="submit" id="btnSubmitClearance" class="btn btn-success" style="width:100%; justify-content:center; padding:11px;">
            Periksa Status Sekarang
          </button>
        </form>
        <div id="clearanceResult" style="margin-top:14px; display:none;"></div>
      </div>
    </div>

    <!-- MODAL AI ASISTEN RISET -->
    <div id="modalChat" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.6); z-index:99999; align-items:center; justify-content:center; padding:16px;">
      <div style="background:var(--surface); color:var(--text); border:1px solid var(--border); border-radius:22px; width:100%; max-width:540px; height:80vh; max-height:600px; padding:20px; display:flex; flex-direction:column; position:relative; box-shadow:0 20px 40px rgba(0,0,0,0.3);">
        <div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:12px; border-bottom:1px solid var(--border);">
          <div style="display:flex; align-items:center; gap:8px;">
            <div style="font-size:22px;">🤖</div>
            <div>
              <div style="font-size:14px; font-weight:800;">INTEGRAL AI • Asisten Riset TI</div>
              <div style="font-size:10.5px; color:var(--text-muted);">Konsultasi metode KP, Skripsi &amp; referensi buku</div>
            </div>
          </div>
          <button onclick="closeModalChat()" style="background:none; border:none; font-size:20px; color:var(--text-muted); cursor:pointer;">&times;</button>
        </div>
        <div id="chatHistory" style="flex:1; overflow-y:auto; padding:12px 0; display:flex; flex-direction:column; gap:10px; font-size:12px;">
          <div style="background:var(--card-subtle); padding:12px 14px; border-radius:14px; max-width:85%;">
            Halo! Saya INTEGRAL AI. Kamu sedang merencanakan Kerja Praktik atau Skripsi tentang metode apa di Teknik Industri?
          </div>
        </div>
        <form onsubmit="handleSendChat(event)" style="display:flex; gap:8px; padding-top:10px; border-top:1px solid var(--border);">
          <input type="text" id="chatInput" class="inp" placeholder="Ketik pertanyaan risetmu..." style="margin-bottom:0;" required />
          <button type="submit" id="btnSendChat" class="btn btn-primary" style="padding:10px 16px;">Kirim</button>
        </form>
      </div>
    </div>

    <!-- MODAL DENAH RAK -->
    <div id="modalDenah" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.6); z-index:99999; align-items:center; justify-content:center; padding:16px;">
      <div style="background:var(--surface); color:var(--text); border:1px solid var(--border); border-radius:22px; width:100%; max-width:440px; padding:22px; position:relative; box-shadow:0 20px 40px rgba(0,0,0,0.3);">
        <button onclick="closeModalDenah()" style="position:absolute; top:16px; right:16px; background:none; border:none; font-size:18px; color:var(--text-muted); cursor:pointer;">&times;</button>
        <div style="font-size:15px; font-weight:800; margin-bottom:12px;">📍 Panduan Letak Rak Ruang Baca TI</div>
        <div style="display:flex; flex-direction:column; gap:10px; font-size:12px;">
          <div style="padding:12px; background:var(--card-subtle); border-radius:12px; border:1px solid var(--border);">
            <div style="font-weight:800; color:#EA580C;">RAK 1: Arsip Laporan Kerja Praktik (KP)</div>
            <div style="color:var(--text-muted); font-size:11px; margin-top:2px;">Tersusun berdasarkan kolom 1 s.d 5 dan baris 1 s.d 5.</div>
          </div>
          <div style="padding:12px; background:var(--card-subtle); border-radius:12px; border:1px solid var(--border);">
            <div style="font-weight:800; color:#9333EA;">RAK 2: Naskah Skripsi / Tugas Akhir</div>
            <div style="color:var(--text-muted); font-size:11px; margin-top:2px;">Koleksi skripsi sarjana Teknik Industri dari tahun ke tahun.</div>
          </div>
          <div style="padding:12px; background:var(--card-subtle); border-radius:12px; border:1px solid var(--border);">
            <div style="font-weight:800; color:#2563EB;">RAK 3: Buku Literatur Kuliah</div>
            <div style="color:var(--text-muted); font-size:11px; margin-top:2px;">Buku teks: Riset Operasional, Ergonomi, Statistik, Mutu, Manajemen.</div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      // Theme Mode
      function toggleThemeMode() {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('integral_theme', next);
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) icon.innerText = next === 'dark' ? '☀️' : '🌙';
      }
      const savedTheme = localStorage.getItem('integral_theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      const iconTheme = document.getElementById('theme-toggle-icon');
      if (iconTheme) iconTheme.innerText = savedTheme === 'dark' ? '☀️' : '🌙';

      // OPAC Search
      const searchInput = document.getElementById('opacSearch');
      const bookCards = document.querySelectorAll('.book-student-card');

      searchInput?.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        bookCards.forEach(c => {
          const text = c.getAttribute('data-search') || '';
          c.style.display = text.includes(q) ? 'flex' : 'none';
        });
      });

      function filterCategory(kat, btn) {
        document.querySelectorAll('.filter-tabs .tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        bookCards.forEach(c => {
          const cardKat = c.getAttribute('data-kategori');
          if (kat === 'all' || cardKat === kat) {
            c.style.display = 'flex';
          } else {
            c.style.display = 'none';
          }
        });
      }

      // Check My Loans
      async function checkMyLoans() {
        const npm = document.getElementById('npmLoanInput').value.trim();
        if (!npm) return alert('Ketik NPM kamu.');
        const btn = document.getElementById('btnCheckLoans');
        const box = document.getElementById('boxLoanResult');
        btn.disabled = true;
        btn.innerText = '...';

        try {
          const res = await fetch('/api/clearance/check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ npm })
          });
          const data = await res.json();
          box.style.display = 'block';

          if (data.cleared) {
            box.innerHTML = `
              <div style="padding:10px; border-radius:10px; background:#DCFCE7; color:#166534; font-size:12px;">
                ✓ <strong>${data.student.nama}</strong>: Tidak memiliki tanggungan peminjaman aktif.
              </div>
            `;
          } else {
            box.innerHTML = `
              <div style="padding:10px; border-radius:10px; background:#FEE2E2; color:#991B1B; font-size:12px;">
                ⚠️ <strong>${data.student.nama}</strong>: Ada ${data.active_loans.length} peminjaman yang belum dikembalikan.
              </div>
            `;
          }
        } catch (err) {
          alert('Koneksi bermasalah.');
        } finally {
          btn.disabled = false;
          btn.innerText = 'Cek';
        }
      }

      // Modals
      function openModalClearance() { document.getElementById('modalClearance').style.display = 'flex'; }
      function closeModalClearance() { document.getElementById('modalClearance').style.display = 'none'; }
      function openModalChat() { document.getElementById('modalChat').style.display = 'flex'; }
      function closeModalChat() { document.getElementById('modalChat').style.display = 'none'; }
      function openModalDenah() { document.getElementById('modalDenah').style.display = 'flex'; }
      function closeModalDenah() { document.getElementById('modalDenah').style.display = 'none'; }

      // Clearance Submit
      async function handleCheckClearance(e) {
        e.preventDefault();
        const npm = document.getElementById('clearanceNpmInput').value.trim();
        const btn = document.getElementById('btnSubmitClearance');
        const box = document.getElementById('clearanceResult');
        btn.disabled = true;
        btn.innerText = 'Memverifikasi basis data...';
        box.style.display = 'none';

        try {
          const res = await fetch('/api/clearance/check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ npm })
          });
          const data = await res.json();
          box.style.display = 'block';

          if (data.cleared) {
            box.innerHTML = `
              <div style="padding:14px; background:#DCFCE7; color:#166534; border-radius:12px; font-size:12px;">
                <div style="font-weight:800; font-size:13px; margin-bottom:4px;">🎉 Bebas Dari Segala Tanggungan!</div>
                <div>Mahasiswa: <strong>${data.student.nama}</strong> (${data.student.npm})</div>
                <div style="font-family:monospace; font-weight:800; padding:6px; background:white; border-radius:6px; text-align:center; margin:8px 0; border:1px solid #86EFAC;">
                  ${data.clearance.kode_validasi}
                </div>
                <a href="/verify/${data.clearance.kode_validasi}" target="_blank" class="btn btn-success" style="width:100%; justify-content:center; text-decoration:none;">
                  Buka &amp; Cetak Surat Bebas Ruang Baca ↗
                </a>
              </div>
            `;
          } else {
            box.innerHTML = `
              <div style="padding:14px; background:#FEE2E2; color:#991B1B; border-radius:12px; font-size:12px;">
                <div style="font-weight:800; font-size:13px; margin-bottom:4px;">⚠️ Masih Memiliki Tanggungan</div>
                <div>Mahasiswa: <strong>${data.student.nama}</strong></div>
                <div style="margin-top:4px;">${data.message}</div>
              </div>
            `;
          }
        } catch (err) {
          alert('Koneksi gagal.');
        } finally {
          btn.disabled = false;
          btn.innerText = 'Periksa Status Sekarang';
        }
      }

      // Chat AI
      async function handleSendChat(e) {
        e.preventDefault();
        const input = document.getElementById('chatInput');
        const history = document.getElementById('chatHistory');
        const btn = document.getElementById('btnSendChat');
        const message = input.value.trim();
        if (!message) return;

        history.innerHTML += `
          <div style="background:var(--accent); color:white; padding:10px 14px; border-radius:14px; max-width:85%; align-self:flex-end;">
            ${message}
          </div>
        `;
        input.value = '';
        btn.disabled = true;
        history.scrollTop = history.scrollHeight;

        try {
          const res = await fetch('/api/ai/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message })
          });
          const data = await res.json();
          history.innerHTML += `
            <div style="background:var(--card-subtle); color:var(--text); padding:12px 14px; border-radius:14px; max-width:90%;">
              ${data.reply.replace(/\n/g, '<br/>')}
            </div>
          `;
        } catch (err) {
          history.innerHTML += `<div style="color:#EF4444;">Gagal menghubungi AI.</div>`;
        } finally {
          btn.disabled = false;
          history.scrollTop = history.scrollHeight;
        }
      }
    </script>
  </body>
</html>
