        window.navTo = function (page) {
            window.toggleSidebar(false);
            document.querySelectorAll(".nav-item").forEach(function (b) { b.classList.remove("active"); });
            document.querySelectorAll(".main-body > div").forEach(function (d) {
                d.style.display = "none";
                d.classList.remove("view-enter");
            });
            var targetPage = document.getElementById("page-" + page);
            if (targetPage) {
                targetPage.style.display = "block";
                void targetPage.offsetWidth;
                targetPage.classList.add("view-enter");
            }
            var btn = document.getElementById("btn-" + (page === "peminjaman" ? "pinjam" : (page === "mahasiswa" ? "mhs" : page)));
            if (btn) btn.classList.add("active");

            var subTitle = document.querySelector(".header-subtitle");
            if (subTitle) {
                var mapTitle = {
                    "dashboard": "/ Ruang Baca & Sirkulasi TI UNIROW",
                    "buku": "/ Koleksi Buku & Naskah",
                    "peminjaman": "/ Layanan Sirkulasi & Peminjaman",
                    "mahasiswa": "/ Database Anggota & Mahasiswa",
                    "rekap": "/ Rekapitulasi & Statistik"
                };
                subTitle.style.opacity = "0.2";
                setTimeout(function () {
                    subTitle.innerText = mapTitle[page] || "/ Ruang Baca & Sirkulasi TI UNIROW";
                    subTitle.style.opacity = "1";
                }, 120);
            }

            if (page === "buku") {
                window.kembaliKePilihanKategori();
