---
import Layout from '@/layouts/Layout.astro';

const userCookie = Astro.cookies.get('integral_user');
if (!userCookie) {
  return Astro.redirect('/login');
}
---

<Layout title="Smart AI Vision Scanner • INTEGRAL" admin={true}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <a href="/admin" class="text-xs text-indigo-600 hover:text-indigo-700 font-semibold">← Kembali ke Dashboard Sirkulasi</a>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1 flex items-center gap-2">
          <span>📷</span> Smart AI Vision Book Scanner
        </h1>
        <p class="text-xs text-slate-500">
          Ambil foto sampul buku, naskah KP, atau barcode. Google Gemini AI akan mengekstrak judul, penulis, tahun, dan menentukan rak secara otomatis.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
      <!-- Left Column: Camera / File Upload -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs space-y-4">
        <div class="relative aspect-4/3 bg-slate-950 rounded-2xl overflow-hidden flex items-center justify-center border border-slate-800">
          <video id="webcam" autoplay playsinline class="w-full h-full object-cover hidden"></video>
          <img id="imagePreview" class="w-full h-full object-contain hidden" alt="Preview Cover" />
          <div id="placeholderCamera" class="text-center p-6 text-slate-500">
            <div class="text-3xl mb-2">📸</div>
            <p class="text-xs">Aktifkan kamera atau unggah foto sampul buku</p>
          </div>
          <canvas id="canvas" class="hidden"></canvas>
        </div>

        <div class="flex flex-wrap gap-2">
          <button type="button" onclick="startCamera()" id="btnStartCam" class="flex-1 py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-colors">
            Nyalakan Kamera
          </button>
          <button type="button" onclick="capturePhoto()" id="btnCapture" class="hidden flex-1 py-2.5 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition-colors">
            Ambil Foto
          </button>
          <label class="flex-1 py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold text-center cursor-pointer transition-colors">
            Pilih Berkas Foto
            <input type="file" id="fileInput" accept="image/*" class="hidden" onchange="handleFileSelect(event)" />
          </label>
        </div>

        <button
          type="button"
          onclick="analyzeWithAI()"
          id="btnAnalyze"
          disabled
          class="w-full py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 disabled:opacity-40 text-white font-extrabold text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-2"
        >
          <span>✨</span> Analisis dengan Gemini AI Vision
        </button>
      </div>

      <!-- Right Column: Extracted Book Form -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs space-y-4">
        <h3 class="font-extrabold text-sm text-slate-900 border-b border-slate-100 pb-3 flex items-center justify-between">
          <span>Hasil Ekstraksi Metadata Buku</span>
          <span id="aiBadge" class="hidden px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">
            ✓ Terverifikasi AI
          </span>
        </h3>

        <form id="bookForm" onsubmit="handleSaveBook(event)" class="space-y-3 text-xs">
          <div>
            <label class="block font-semibold text-slate-700 mb-1">ID Buku / Nomor Induk</label>
            <input type="text" id="bookId" required placeholder="Contoh: 1500" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-mono text-xs focus:ring-2 focus:ring-indigo-500/20" />
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-1">Judul Lengkap Buku / Naskah</label>
            <textarea id="bookJudul" rows="2" required placeholder="Judul buku akan terisi otomatis oleh AI..." class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-indigo-500/20"></textarea>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Penulis / Penyusun</label>
              <input type="text" id="bookPenulis" placeholder="Nama penulis" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs" />
            </div>
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Tahun Terbit</label>
              <input type="text" id="bookTahun" placeholder="2024" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Kategori</label>
              <select id="bookKategori" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs font-medium">
                <option value="Buku Literatur">Buku Literatur</option>
                <option value="Laporan KP">Laporan KP</option>
                <option value="Skripsi">Skripsi</option>
              </select>
            </div>
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Nomor Rak</label>
              <input type="text" id="bookRak" placeholder="RAK 3 BARIS 1" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs font-mono" />
            </div>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-1">Jumlah Stok Fisik</label>
            <input type="number" id="bookStok" value="1" min="1" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs" />
          </div>

          <button
            type="submit"
            id="btnSaveBook"
            class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs shadow-md shadow-emerald-600/20 transition-all mt-2"
          >
            Simpan ke Katalog Database
          </button>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    let currentBase64 = null;
    let stream = null;

    const video = document.getElementById('webcam');
    const imagePreview = document.getElementById('imagePreview');
    const placeholder = document.getElementById('placeholderCamera');
    const btnCapture = document.getElementById('btnCapture');
    const btnAnalyze = document.getElementById('btnAnalyze');
    const canvas = document.getElementById('canvas');

    async function startCamera() {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        video.srcObject = stream;
        video.classList.remove('hidden');
        imagePreview.classList.add('hidden');
        placeholder.classList.add('hidden');
        btnCapture.classList.remove('hidden');
      } catch (err) {
        alert('Tidak dapat mengakses kamera: ' + err.message);
      }
    }

    function capturePhoto() {
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0);

      currentBase64 = canvas.toDataURL('image/jpeg', 0.85);
      imagePreview.src = currentBase64;
      imagePreview.classList.remove('hidden');
      video.classList.add('hidden');
      btnCapture.classList.add('hidden');

      if (stream) {
        stream.getTracks().forEach(t => t.stop());
      }
      btnAnalyze.disabled = false;
    }

    function handleFileSelect(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        currentBase64 = evt.target.result;
        imagePreview.src = currentBase64;
        imagePreview.classList.remove('hidden');
        video.classList.add('hidden');
        placeholder.classList.add('hidden');
        btnCapture.classList.add('hidden');
        btnAnalyze.disabled = false;
      };
      reader.readAsDataURL(file);
    }

    async function analyzeWithAI() {
      if (!currentBase64) return;
      btnAnalyze.disabled = true;
      btnAnalyze.innerText = 'Menganalisis gambar dengan Gemini AI...';

      try {
        const res = await fetch('/api/ai/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ image: currentBase64 })
        });
        const result = await res.json();

        if (result.success && result.data) {
          const d = result.data;
          document.getElementById('bookJudul').value = d.judul || '';
          document.getElementById('bookPenulis').value = d.penulis || '';
          document.getElementById('bookTahun').value = d.tahun || '';
          if (d.kategori) document.getElementById('bookKategori').value = d.kategori;
          document.getElementById('bookRak').value = d.rak || '';
          document.getElementById('aiBadge').classList.remove('hidden');
        } else {
          alert('AI Scanner: ' + (result.message || 'Gagal memindai'));
        }
      } catch (err) {
        alert('Kesalahan jaringan.');
      } finally {
        btnAnalyze.disabled = false;
        btnAnalyze.innerText = '✨ Analisis dengan Gemini AI Vision';
      }
    }

    async function handleSaveBook(e) {
      e.preventDefault();
      const id = document.getElementById('bookId').value.trim();
      const judul = document.getElementById('bookJudul').value.trim();
      const penulis = document.getElementById('bookPenulis').value.trim();
      const tahun_terbit = document.getElementById('bookTahun').value.trim();
      const kategori = document.getElementById('bookKategori').value;
      const rak = document.getElementById('bookRak').value.trim();
      const stok = parseInt(document.getElementById('bookStok').value) || 1;

      const btn = document.getElementById('btnSaveBook');
      btn.disabled = true;
      btn.innerText = 'Menyimpan ke Supabase...';

      try {
        const res = await fetch('/api/collections/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, judul, penulis, tahun_terbit, kategori, rak, stok })
        });
        const data = await res.json();
        if (data.success) {
          alert('Buku berhasil disimpan ke katalog Supabase!');
          window.location.href = '/admin';
        } else {
          alert('Gagal: ' + data.message);
        }
      } catch (err) {
        alert('Kesalahan server.');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Simpan ke Katalog Database';
      }
    }
  </script>
</Layout>

