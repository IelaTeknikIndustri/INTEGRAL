---
import '@/styles/global.css';
import { supabaseAdmin } from '@/lib/supabase';
import { formatDateIndo, formatRupiah } from '@/lib/utils';

// Check Auth Cookie
const userCookie = Astro.cookies.get('integral_user');
if (!userCookie) {
  return Astro.redirect('/login');
}
const currentUser = JSON.parse(userCookie.value);

// Fetch Circulation Data (Active Loans with Items & Students)
const { data: loans = [] } = await supabaseAdmin
  .from('loans')
  .select(`
    id,
    student_npm,
    tgl_pinjam,
    batas_kembali,
    status,
    total_denda,
    hari_terlambat,
    students(nama, no_hp, email),
    loan_items(id, status, collection_id, collections(judul, rak, kategori))
  `)
  .order('created_at', { ascending: false })
  .limit(50);

// Fetch Quick Counts
const { count: totalLit } = await supabaseAdmin.from('collections').select('*', { count: 'exact', head: true }).eq('kategori', 'Buku Literatur');
const { count: totalKp } = await supabaseAdmin.from('collections').select('*', { count: 'exact', head: true }).eq('kategori', 'Laporan KP');
const { count: totalSkripsi } = await supabaseAdmin.from('collections').select('*', { count: 'exact', head: true }).eq('kategori', 'Skripsi');
const { count: totalStok } = await supabaseAdmin.from('collections').select('*', { count: 'exact', head: true });
const { count: totalMhs } = await supabaseAdmin.from('students').select('*', { count: 'exact', head: true });
const { count: pinjamanAktif } = await supabaseAdmin.from('loans').select('*', { count: 'exact', head: true }).eq('status', 'Dipinjam');

// Fetch Sample Collections for Data Buku Tab
const { data: bookKoleksi = [] } = await supabaseAdmin
  .from('collections')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(100);

// Fetch Students for Mahasiswa Tab
const { data: studentList = [] } = await supabaseAdmin
  .from('students')
  .select('*')
  .order('nama', { ascending: true })
  .limit(100);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/png" href="/logo-integral-7.png" />
    <title>INTEGRAL | Back-Office Ruang Baca TI UNIROW</title>
  </head>
  <body>
    <div style="display:flex; width:100%; height:100vh; overflow:hidden;">
      
      <!-- AUTHENTIC ROYAL GRADIENT SIDEBAR (from index.html line 1109) -->
      <aside class="sidebar hidden md:flex" id="app-sidebar">
        <div>
          <div class="brand-box">
            <img src="https://i.ibb.co/kskd8DBN/1.png" alt="UNIROW" class="brand-logo" />
          </div>
          <nav style="margin-top:20px;">
            <button class="nav-item active" id="btn-dash" onclick="navToTab('dashboard')">
              📊 <span>Dashboard</span>
            </button>
            <button class="nav-item" id="btn-buku" onclick="navToTab('buku')">
              📖 <span>Data Buku</span>
            </button>
            <button class="nav-item" id="btn-mhs" onclick="navToTab('mahasiswa')">
              👥 <span>Mahasiswa</span>
            </button>
            <button class="nav-item" id="btn-pinjam" onclick="navToTab('peminjaman')">
              📋 <span>Peminjaman</span>
            </button>
          </nav>
        </div>

        <div style="font-size:11.5px; color:#A78BFA; text-align:center; line-height:1.4;">
          &copy; 2026 Created by Luqman Firdaus<br />
          <strong style="color:#FFFFFF;">INTEGRAL UNIROW</strong>
        </div>
      </aside>

      <!-- MAIN CONTENT WRAPPER -->
      <div class="main-wrapper">
        <!-- HEADER BAR (Authentic from line 1133) -->
        <header class="header-bar">
          <div style="display:flex; align-items:center;">
            <div style="font-size:16px; font-weight:800; color:var(--text); white-space:nowrap;">
              INTEGRAL <span style="color:var(--accent); font-weight:600;">- Industrial Integrated Library</span>
            </div>
          </div>

          <div style="display:flex; align-items:center; gap:12px;">
            <button class="btn-theme-toggle" onclick="toggleThemeMode()" title="Ganti Mode Gelap / Terang">
              <span id="theme-toggle-icon">🌙</span>
            </button>
            <div style="text-align:right;" class="hidden sm:block">
              <div style="font-size:13px; font-weight:800; color:var(--text);">{currentUser.nama}</div>
              <span class="pill" style="background:#EEF2FF; color:#4338CA; font-size:10px;">{currentUser.role}</span>
            </div>
            <a href="/" target="_blank" class="btn btn-ghost" style="padding:6px 10px; font-size:11.5px; text-decoration:none;" title="Lihat Portal Mahasiswa">
              🌐 <span class="hidden sm:inline">Portal Mahasiswa</span>
            </a>
            <a href="/api/auth/logout" class="btn btn-ghost" style="padding:6px 10px; font-size:14px; text-decoration:none; color:#DC2626;" title="Keluar Akun">
              🚪
            </a>
          </div>
        </header>

        <!-- MAIN BODY CONTAINER -->
        <main class="main-body" style="padding:20px; overflow-y:auto; flex:1;">
          
          <!-- TAB 1: DASHBOARD TAB (Authentic from line 1161) -->
          <div id="tab-dashboard">
            <!-- DASHBOARD WELCOME & LIVE WIB CLOCK -->
            <section class="dashboard-welcome">
              <div class="dashboard-welcome-copy">
                <h1>Selamat Datang di INTEGRAL</h1>
                <p>Pusat pengelolaan sirkulasi, otomasi pengingat, dan koleksi perpustakaan.</p>
              </div>
              <div class="dashboard-clock">
                <div class="dashboard-clock-date" id="clock-date">Memuat tanggal...</div>
                <time class="dashboard-clock-time" id="clock-time">00:00:00</time>
                <div class="dashboard-clock-zone">Waktu Indonesia Barat (WIB)</div>
              </div>
            </section>

            <!-- ACTIONS BAR -->
            <div class="actions-bar">
              <button onclick="openModalPinjam()" class="btn btn-primary">
                + Catat Peminjaman Baru
              </button>
              <button onclick="openModalTambahBuku()" class="btn btn-ghost">
                + Tambah Buku Manual
              </button>
              <a href="/" target="_blank" class="btn btn-ghost" style="text-decoration:none;">
                📜 Halaman Bebas Pustaka
              </a>
            </div>

            <!-- GRID STATS (The authentic 6 cards from line 1197) -->
            <div class="grid-stats">
              <div class="stat-card" style="background:#2563EB;">
                <div class="stat-label">Buku Literatur</div>
                <div class="stat-val">{totalLit || 0}</div>
              </div>
              <div class="stat-card" style="background:#4F46E5;">
                <div class="stat-label">Laporan KP</div>
                <div class="stat-val">{totalKp || 0}</div>
              </div>
              <div class="stat-card" style="background:#9333EA;">
                <div class="stat-label">Skripsi</div>
                <div class="stat-val">{totalSkripsi || 0}</div>
              </div>
              <div class="stat-card" style="background:#16A34A;">
                <div class="stat-label">Total Eksemplar</div>
                <div class="stat-val">{totalStok || 0}</div>
              </div>
              <div class="stat-card" style="background:#0D9488;">
                <div class="stat-label">Mahasiswa Terdaftar</div>
                <div class="stat-val">{totalMhs || 0}</div>
              </div>
              <div class="stat-card" style="background:#EA580C;">
                <div class="stat-label">Pinjaman Aktif</div>
                <div class="stat-val">{pinjamanAktif || 0}</div>
              </div>
            </div>

            <!-- TABLE PEMINJAMAN BERJALAN -->
            <div class="table-box">
              <div style="font-size:14px; font-weight:800; color:var(--text); margin-bottom:12px;">
                📋 Transaksi Peminjaman Berjalan
              </div>
              <table class="tbl">
                <thead>
                  <tr>
                    <th>Mahasiswa</th>
                    <th>Detail Buku &amp; Rak</th>
                    <th>Tgl Pinjam</th>
                    <th>Batas Kembali</th>
                    <th>Status</th>
                    <th style="text-align:right;">Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  {loans.map((loan) => {
                    const studentName = (loan.students as any)?.nama || 'Mahasiswa';
                    const isOverdue = loan.status === 'Terlambat';
                    const items = loan.loan_items || [];

                    return (
                      <tr>
                        <td>
                          <div style="font-weight:800; color:var(--text);">{studentName}</div>
                          <div style="font-size:11px; color:var(--text-muted); font-family:monospace;">{loan.student_npm}</div>
                        </td>
                        <td>
                          {items.map((it) => (
                            <div style="background:var(--card-subtle); padding:6px 10px; border-radius:8px; margin-bottom:4px; border:1px solid var(--border); font-size:11.5px; display:flex; justify-content:space-between; align-items:center;">
                              <span><strong>{(it.collections as any)?.judul || 'Buku'}</strong> (📍 {(it.collections as any)?.rak || '-'})</span>
                              <span class="pill" style={`font-size:9.5px; ${it.status === 'Dipinjam' ? 'background:#FEF3C7; color:#92400E;' : 'background:#DCFCE7; color:#166534;'}`}>
                                {it.status}
                              </span>
                            </div>
                          ))}
                        </td>
                        <td style="color:var(--text-muted);">{formatDateIndo(loan.tgl_pinjam)}</td>
                        <td>
                          <strong style={`color:${isOverdue ? '#DC2626' : 'var(--text)'};`}>
                            {formatDateIndo(loan.batas_kembali)}
                          </strong>
                        </td>
                        <td>
                          <span class={`pill ${loan.status === 'Dipinjam' ? 'pill-aktif' : loan.status === 'Terlambat' ? 'pill-terlambat' : 'pill-selesai'}`}>
                            {loan.status}
                          </span>
                          {loan.total_denda > 0 && (
                            <div style="color:#DC2626; font-weight:800; font-size:11.5px; margin-top:3px;">
                              {formatRupiah(loan.total_denda)}
                            </div>
                          )}
                        </td>
                        <td style="text-align:right;">
                          {items.map((it) => it.status === 'Dipinjam' && (
                            <div style="display:flex; justify-content:flex-end; gap:4px; margin-bottom:2px;">
                              <button onclick={`handleReturnItem('${it.id}', 'kembali')`} class="btn btn-success" style="padding:4px 8px; font-size:10.5px;">
                                ✓ Kembali
                              </button>
                              <button onclick={`handleReturnItem('${it.id}', 'rusak')`} class="btn btn-ghost" style="padding:4px 8px; font-size:10.5px; color:#DC2626;">
                                Rusak
                              </button>
                            </div>
                          ))}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>

          <!-- TAB 2: DATA BUKU TAB (Authentic from line 1225) -->
          <div id="tab-buku" style="display:none;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:8px;">
              <div style="font-size:16px; font-weight:800; color:var(--text);">📖 Inventaris Katalog Koleksi</div>
              <button onclick="openModalTambahBuku()" class="btn btn-primary">+ Tambah Buku Baru</button>
            </div>
            <div class="table-box">
              <table class="tbl">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Judul Koleksi</th>
                    <th>Kategori</th>
                    <th>Penulis</th>
                    <th>Tahun</th>
                    <th>Stok</th>
                    <th>Rak</th>
                  </tr>
                </thead>
                <tbody>
                  {bookKoleksi.map((b) => (
                    <tr>
                      <td style="font-family:monospace; font-weight:700;">#{b.id}</td>
                      <td><strong>{b.judul}</strong></td>
                      <td><span class="pill" style="background:#EEF2FF; color:#4338CA;">{b.kategori}</span></td>
                      <td style="color:var(--text-muted);">{b.penulis}</td>
                      <td>{b.tahun_terbit}</td>
                      <td><strong style={`color:${b.stok > 0 ? '#16A34A' : '#DC2626'};`}>{b.stok}</strong></td>
                      <td><span class="pill" style="background:var(--card-subtle); color:var(--text);">📍 {b.rak}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- TAB 3: MAHASISWA TAB (Authentic from line 1328) -->
          <div id="tab-mahasiswa" style="display:none;">
            <div style="font-size:16px; font-weight:800; color:var(--text); margin-bottom:14px;">👥 Direktori Mahasiswa Teknik Industri</div>
            <div class="table-box">
              <table class="tbl">
                <thead>
                  <tr>
                    <th>NPM</th>
                    <th>Nama Mahasiswa</th>
                    <th>Angkatan</th>
                    <th>Status</th>
                    <th>Email</th>
                    <th>No. HP</th>
                  </tr>
                </thead>
                <tbody>
                  {studentList.map((m) => (
                    <tr>
                      <td style="font-family:monospace; font-weight:800; color:var(--accent);">{m.npm}</td>
                      <td><strong>{m.nama}</strong></td>
                      <td>{m.angkatan}</td>
                      <td><span class="pill pill-aktif">{m.status}</span></td>
                      <td style="color:var(--text-muted); font-size:11.5px;">{m.email || '-'}</td>
                      <td style="color:var(--text-muted); font-size:11.5px;">{m.no_hp || '-'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- TAB 4: PEMINJAMAN TAB (Authentic from line 1380) -->
          <div id="tab-peminjaman" style="display:none;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
              <div style="font-size:16px; font-weight:800; color:var(--text);">📋 Arsip &amp; Riwayat Peminjaman</div>
              <button onclick="openModalPinjam()" class="btn btn-primary">+ Catat Pinjam Baru</button>
            </div>
            <div class="table-box">
              <table class="tbl">
                <thead>
                  <tr>
                    <th>NPM</th>
                    <th>Nama Mahasiswa</th>
                    <th>Tgl Pinjam</th>
                    <th>Batas Kembali</th>
                    <th>Status</th>
                    <th>Total Denda</th>
                  </tr>
                </thead>
                <tbody>
                  {loans.map((l) => (
                    <tr>
                      <td style="font-family:monospace; font-weight:700;">{l.student_npm}</td>
                      <td><strong>{(l.students as any)?.nama || 'Mahasiswa'}</strong></td>
                      <td>{formatDateIndo(l.tgl_pinjam)}</td>
                      <td>{formatDateIndo(l.batas_kembali)}</td>
                      <td><span class={`pill ${l.status === 'Dipinjam' ? 'pill-aktif' : l.status === 'Terlambat' ? 'pill-terlambat' : 'pill-selesai'}`}>{l.status}</span></td>
                      <td><strong>{l.total_denda > 0 ? formatRupiah(l.total_denda) : 'Rp 0'}</strong></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

        </main>
      </div>

    </div>

    <!-- MODAL CATAT PEMINJAMAN -->
    <div id="modalPinjam" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.6); z-index:99999; align-items:center; justify-content:center; padding:16px;">
      <div style="background:var(--surface); color:var(--text); border:1px solid var(--border); border-radius:22px; width:100%; max-width:440px; padding:24px; position:relative;">
        <button onclick="closeModalPinjam()" style="position:absolute; top:16px; right:16px; background:none; border:none; font-size:18px; color:var(--text-muted); cursor:pointer;">&times;</button>
        <div style="font-size:16px; font-weight:800; margin-bottom:14px;">Catat Peminjaman Baru</div>
        <form onsubmit="handleCreateLoan(event)">
          <div style="margin-bottom:10px;">
            <label style="font-size:12px; font-weight:700;">NPM Mahasiswa</label>
            <input type="text" id="loanNpm" class="inp" placeholder="Contoh: 1411230105" required />
          </div>
          <div style="margin-bottom:10px;">
            <label style="font-size:12px; font-weight:700;">ID Buku (pisahkan koma jika > 1)</label>
            <input type="text" id="loanBookIds" class="inp" placeholder="Contoh: 1060, 2001" required />
          </div>
          <div style="margin-bottom:14px;">
            <label style="font-size:12px; font-weight:700;">Durasi Pinjam (Hari)</label>
            <input type="number" id="loanDuration" class="inp" value="7" min="1" max="14" />
          </div>
          <button type="submit" id="btnSubmitLoan" class="btn btn-primary" style="width:100%; justify-content:center; padding:11px;">
            Simpan Transaksi Peminjaman
          </button>
        </form>
      </div>
    </div>

    <!-- MODAL TAMBAH BUKU MANUAL -->
    <div id="modalTambahBuku" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.6); z-index:99999; align-items:center; justify-content:center; padding:16px;">
      <div style="background:var(--surface); color:var(--text); border:1px solid var(--border); border-radius:22px; width:100%; max-width:440px; padding:24px; position:relative;">
        <button onclick="closeModalTambahBuku()" style="position:absolute; top:16px; right:16px; background:none; border:none; font-size:18px; color:var(--text-muted); cursor:pointer;">&times;</button>
        <div style="font-size:16px; font-weight:800; margin-bottom:14px;">Tambah Buku Baru</div>
        <form onsubmit="handleSaveManualBook(event)">
          <div style="margin-bottom:10px;">
            <label style="font-size:12px; font-weight:700;">ID Buku / Nomor Induk</label>
            <input type="text" id="manualBookId" class="inp" placeholder="Contoh: 1500" required />
          </div>
          <div style="margin-bottom:10px;">
            <label style="font-size:12px; font-weight:700;">Judul Koleksi</label>
            <input type="text" id="manualBookJudul" class="inp" placeholder="Judul buku / skripsi..." required />
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:10px;">
            <div>
              <label style="font-size:12px; font-weight:700;">Penulis</label>
              <input type="text" id="manualBookPenulis" class="inp" placeholder="Penulis" />
            </div>
            <div>
              <label style="font-size:12px; font-weight:700;">Tahun</label>
              <input type="text" id="manualBookTahun" class="inp" placeholder="2026" />
            </div>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:14px;">
            <div>
              <label style="font-size:12px; font-weight:700;">Kategori</label>
              <select id="manualBookKategori" class="inp">
                <option value="Buku Literatur">Buku Literatur</option>
                <option value="Laporan KP">Laporan KP</option>
                <option value="Skripsi">Skripsi</option>
              </select>
            </div>
            <div>
              <label style="font-size:12px; font-weight:700;">Lokasi Rak</label>
              <input type="text" id="manualBookRak" class="inp" placeholder="RAK 3 BARIS 1" required />
            </div>
          </div>
          <button type="submit" id="btnSubmitManualBook" class="btn btn-success" style="width:100%; justify-content:center; padding:11px;">
            Simpan ke Supabase
          </button>
        </form>
      </div>
    </div>

    <script is:inline>
      // Live Digital Clock
      function updateWibClock() {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        const timeElem = document.getElementById('clock-time');
        if (timeElem) timeElem.innerText = `${hours}:${minutes}:${seconds}`;

        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const dateElem = document.getElementById('clock-date');
        if (dateElem) dateElem.innerText = now.toLocaleDateString('id-ID', options);
      }
      setInterval(updateWibClock, 1000);
      updateWibClock();

      // Theme toggle
      function toggleThemeMode() {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('integral_theme', next);
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) icon.innerText = next === 'dark' ? '☀️' : '🌙';
      }
      const savedTheme = localStorage.getItem('integral_theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      const iconTheme = document.getElementById('theme-toggle-icon');
      if (iconTheme) iconTheme.innerText = savedTheme === 'dark' ? '☀️' : '🌙';

      // Navigation Tabs
      function navToTab(tab) {
        ['dashboard', 'buku', 'mahasiswa', 'peminjaman'].forEach(t => {
          const tabEl = document.getElementById(`tab-${t}`);
          if (tabEl) tabEl.style.display = t === tab ? 'block' : 'none';
        });
        document.querySelectorAll('.sidebar .nav-item').forEach(b => b.classList.remove('active'));
        if (tab === 'dashboard') document.getElementById('btn-dash')?.classList.add('active');
        if (tab === 'buku') document.getElementById('btn-buku')?.classList.add('active');
        if (tab === 'mahasiswa') document.getElementById('btn-mhs')?.classList.add('active');
        if (tab === 'peminjaman') document.getElementById('btn-pinjam')?.classList.add('active');
      }

      // Modals
      function openModalPinjam() { document.getElementById('modalPinjam').style.display = 'flex'; }
      function closeModalPinjam() { document.getElementById('modalPinjam').style.display = 'none'; }
      function openModalTambahBuku() { document.getElementById('modalTambahBuku').style.display = 'flex'; }
      function closeModalTambahBuku() { document.getElementById('modalTambahBuku').style.display = 'none'; }

      async function handleReturnItem(itemId, aksi) {
        if (!confirm(`Konfirmasi pengembalian item ini (Aksi: ${aksi})?`)) return;
        try {
          const res = await fetch('/api/loans/return', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ loan_item_id: itemId, aksi })
          });
          const data = await res.json();
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('Error: ' + data.message);
          }
        } catch (err) {
          alert('Koneksi gagal.');
        }
      }

      async function handleCreateLoan(e) {
        e.preventDefault();
        const npm = document.getElementById('loanNpm').value.trim();
        const idsRaw = document.getElementById('loanBookIds').value.trim();
        const durasi = document.getElementById('loanDuration').value;
        const btn = document.getElementById('btnSubmitLoan');
        const collection_ids = idsRaw.split(',').map(s => s.trim()).filter(Boolean);

        btn.disabled = true;
        btn.innerText = 'Menyimpan...';

        try {
          const res = await fetch('/api/loans/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ student_npm: npm, collection_ids, durasi_hari: durasi })
          });
          const data = await res.json();
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('Gagal: ' + data.message);
          }
        } catch (err) {
          alert('Kesalahan jaringan.');
        } finally {
          btn.disabled = false;
          btn.innerText = 'Simpan Transaksi Peminjaman';
        }
      }

      async function handleSaveManualBook(e) {
        e.preventDefault();
        const id = document.getElementById('manualBookId').value.trim();
        const judul = document.getElementById('manualBookJudul').value.trim();
        const penulis = document.getElementById('manualBookPenulis').value.trim();
        const tahun_terbit = document.getElementById('manualBookTahun').value.trim();
        const kategori = document.getElementById('manualBookKategori').value;
        const rak = document.getElementById('manualBookRak').value.trim();

        const btn = document.getElementById('btnSubmitManualBook');
        btn.disabled = true;
        btn.innerText = 'Menyimpan...';

        try {
          const res = await fetch('/api/collections/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, judul, penulis, tahun_terbit, kategori, rak, stok: 1 })
          });
          const data = await res.json();
          if (data.success) {
            alert('Buku berhasil disimpan ke Supabase!');
            window.location.reload();
          } else {
            alert('Gagal: ' + data.message);
          }
        } catch (err) {
          alert('Kesalahan jaringan.');
        } finally {
          btn.disabled = false;
          btn.innerText = 'Simpan ke Supabase';
        }
      }
    </script>
  </body>
</html>
