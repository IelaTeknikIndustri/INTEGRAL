---
import Layout from '@/layouts/Layout.astro';
import { supabaseAdmin } from '@/lib/supabase';
import { formatDateIndo, formatRupiah } from '@/lib/utils';

// Check Auth Cookie
const userCookie = Astro.cookies.get('integral_user');
if (!userCookie) {
  return Astro.redirect('/login');
}
const currentUser = JSON.parse(userCookie.value);

// Fetch Circulation Data (Active Loans with Items & Students)
const { data: loans = [] } = await supabaseAdmin
  .from('loans')
  .select(`
    id,
    student_npm,
    tgl_pinjam,
    batas_kembali,
    status,
    total_denda,
    hari_terlambat,
    students(nama, no_hp, email),
    loan_items(id, status, collection_id, collections(judul, rak, kategori))
  `)
  .order('created_at', { ascending: false })
  .limit(50);

// Fetch quick counts
const { count: totalKoleksi } = await supabaseAdmin.from('collections').select('*', { count: 'exact', head: true });
const { count: pinjamanAktif } = await supabaseAdmin.from('loans').select('*', { count: 'exact', head: true }).eq('status', 'Dipinjam');
const { count: pinjamanTerlambat } = await supabaseAdmin.from('loans').select('*', { count: 'exact', head: true }).eq('status', 'Terlambat');
---

<Layout title="Staff Dashboard • INTEGRAL UNIROW" admin={true}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Top Greeting & Action Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs">
      <div>
        <div class="text-xs font-semibold text-indigo-600 uppercase tracking-wider">Workspace Ruang Baca</div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-0.5">
          Selamat Datang, {currentUser.nama}!
        </h1>
        <p class="text-xs text-slate-500 mt-1">
          Role: <span class="font-bold text-slate-700">{currentUser.role}</span> • Sistem sirkulasi siap melayani peminjaman & pengembalian.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/admin/scanner" class="px-4 py-2.5 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-700 font-bold text-xs hover:bg-indigo-100 transition-all flex items-center gap-2">
          <span>📷</span> Smart AI Vision Scanner
        </a>
        <button onclick="openModalPinjam()" class="px-4 py-2.5 rounded-xl bg-indigo-600 text-white font-bold text-xs hover:bg-indigo-700 transition-all shadow-md shadow-indigo-600/20 flex items-center gap-2">
          <span>+</span> Catat Peminjaman Baru
        </button>
      </div>
    </div>

    <!-- Circulation Overview Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs flex items-center justify-between">
        <div>
          <div class="text-2xl font-black text-slate-900">{pinjamanAktif || 0}</div>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Pinjaman Aktif</div>
        </div>
        <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">📖</div>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs flex items-center justify-between">
        <div>
          <div class="text-2xl font-black text-rose-600">{pinjamanTerlambat || 0}</div>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Terlambat (Denda)</div>
        </div>
        <div class="h-10 w-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold">⚠️</div>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs flex items-center justify-between">
        <div>
          <div class="text-2xl font-black text-slate-900">{totalKoleksi || 977}</div>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Total Katalog Buku</div>
        </div>
        <div class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">📚</div>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs flex items-center justify-between">
        <div>
          <div class="text-2xl font-black text-emerald-600">Rp 1.000</div>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Tarif Denda / Hari</div>
        </div>
        <div class="h-10 w-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">🪙</div>
      </div>
    </div>

    <!-- Active Circulation Table -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-extrabold text-slate-900 tracking-tight">Daftar Transaksi Sirkulasi Terbaru</h2>
          <p class="text-xs text-slate-500 mt-0.5">Pantau status pengembalian buku, denda, dan sirkulasi per-item.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50/80 text-slate-500 font-semibold uppercase tracking-wider border-b border-slate-100">
            <tr>
              <th class="py-3.5 px-6">Mahasiswa</th>
              <th class="py-3.5 px-6">Buku & Lokasi Rak</th>
              <th class="py-3.5 px-6">Tgl Pinjam</th>
              <th class="py-3.5 px-6">Batas Waktu</th>
              <th class="py-3.5 px-6">Status / Denda</th>
              <th class="py-3.5 px-6 text-right">Aksi Item</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-medium">
            {loans.map((loan) => {
              const studentName = (loan.students as any)?.nama || 'Mahasiswa';
              const isOverdue = loan.status === 'Terlambat';
              const items = loan.loan_items || [];

              return (
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="py-4 px-6">
                    <div class="font-bold text-slate-900 text-sm">{studentName}</div>
                    <div class="font-mono text-[11px] text-slate-500">{loan.student_npm}</div>
                  </td>
                  <td class="py-4 px-6 max-w-xs space-y-2">
                    {items.map((item) => (
                      <div class="p-2 rounded-xl bg-slate-50 border border-slate-200/60 text-[11px] flex items-center justify-between gap-2">
                        <div class="truncate">
                          <span class="font-bold text-slate-800">{(item.collections as any)?.judul || 'Buku'}</span>
                          <div class="text-[10px] text-slate-500">📍 {(item.collections as any)?.rak || '-'}</div>
                        </div>
                        <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${item.status === 'Dipinjam' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}`}>
                          {item.status}
                        </span>
                      </div>
                    ))}
                  </td>
                  <td class="py-4 px-6 text-slate-600">{formatDateIndo(loan.tgl_pinjam)}</td>
                  <td class="py-4 px-6">
                    <div class={`font-bold ${isOverdue ? 'text-rose-600' : 'text-slate-700'}`}>
                      {formatDateIndo(loan.batas_kembali)}
                    </div>
                  </td>
                  <td class="py-4 px-6">
                    <span class={`px-2.5 py-1 rounded-full text-[10px] font-bold ${
                      loan.status === 'Dipinjam' ? 'bg-blue-100 text-blue-700' :
                      loan.status === 'Terlambat' ? 'bg-rose-100 text-rose-700' :
                      'bg-emerald-100 text-emerald-700'
                    }`}>
                      {loan.status}
                    </span>
                    {loan.total_denda > 0 && (
                      <div class="text-xs font-bold text-rose-600 mt-1">{formatRupiah(loan.total_denda)}</div>
                    )}
                  </td>
                  <td class="py-4 px-6 text-right space-y-1">
                    {items.map((item) => item.status === 'Dipinjam' && (
                      <div class="flex justify-end gap-1">
                        <button onclick={`handleReturnItem('${item.id}', 'kembali')`} class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px]">
                          ✓ Kembali
                        </button>
                        <button onclick={`handleReturnItem('${item.id}', 'rusak')`} class="px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-[11px] border border-rose-200">
                          Rusak
                        </button>
                      </div>
                    ))}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Peminjaman Baru -->
  <div id="modalPinjam" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-100 relative">
      <button onclick="closeModalPinjam()" class="absolute top-5 right-5 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>

      <div class="mb-6">
        <h3 class="text-xl font-extrabold text-slate-900">Catat Peminjaman Baru</h3>
        <p class="text-xs text-slate-500 mt-0.5">Pilih mahasiswa dan buku yang akan dipinjam.</p>
      </div>

      <form onsubmit="handleCreateLoan(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">NPM Mahasiswa</label>
          <input type="text" id="loanNpm" placeholder="Contoh: 1411230105" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs font-mono" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">ID Buku / Koleksi (pisahkan koma jika > 1)</label>
          <input type="text" id="loanBookIds" placeholder="Contoh: 1060, 2001" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs font-mono" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Durasi Peminjaman (Hari)</label>
          <input type="number" id="loanDuration" value="7" min="1" max="14" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs" />
        </div>

        <button type="submit" id="btnSubmitLoan" class="w-full py-3 rounded-xl bg-indigo-600 text-white font-bold text-xs hover:bg-indigo-700 shadow-md shadow-indigo-600/20">
          Simpan Transaksi Peminjaman
        </button>
      </form>
    </div>
  </div>

  <script is:inline>
    function openModalPinjam() { document.getElementById('modalPinjam').classList.remove('hidden'); }
    function closeModalPinjam() { document.getElementById('modalPinjam').classList.add('hidden'); }

    async function handleReturnItem(itemId, aksi) {
      if (!confirm(`Konfirmasi pengembalian item ini (Aksi: ${aksi})?`)) return;

      try {
        const res = await fetch('/api/loans/return', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ loan_item_id: itemId, aksi })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message);
          window.location.reload();
        } else {
          alert('Error: ' + data.message);
        }
      } catch (err) {
        alert('Gagal menghubungi server.');
      }
    }

    async function handleCreateLoan(e) {
      e.preventDefault();
      const npm = document.getElementById('loanNpm').value.trim();
      const idsRaw = document.getElementById('loanBookIds').value.trim();
      const durasi = document.getElementById('loanDuration').value;
      const btn = document.getElementById('btnSubmitLoan');

      const collection_ids = idsRaw.split(',').map(s => s.trim()).filter(Boolean);
      btn.disabled = true;
      btn.innerText = 'Menyimpan...';

      try {
        const res = await fetch('/api/loans/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ student_npm: npm, collection_ids, durasi_hari: durasi })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message);
          window.location.reload();
        } else {
          alert('Gagal: ' + data.message);
        }
      } catch (err) {
        alert('Kesalahan koneksi.');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Simpan Transaksi Peminjaman';
      }
    }
  </script>
</Layout>

