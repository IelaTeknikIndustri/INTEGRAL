---
import '../styles/global.css';

interface Props {
  title?: string;
  admin?: boolean;
  currentUser?: { nama: string; role: string } | null;
}

const {
  title = 'INTEGRAL | Pusat Sirkulasi Perpustakaan TI UNIROW',
  admin = false,
  currentUser = null
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/png" href="/logo-integral-7.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-40 w-full h-16 border-b transition-colors backdrop-blur-md"
            style="background: var(--surface); border-color: var(--border);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between">
        <!-- Brand Left -->
        <a href={admin ? "/admin" : "/"} class="flex items-center gap-3 group">
          <img src="/logo-integral-7.png" alt="INTEGRAL" class="h-9 w-auto object-contain transition-transform group-hover:scale-105" />
          <div class="hidden sm:block border-l-2 pl-3" style="border-color: var(--border);">
            <div class="text-[13px] font-extrabold tracking-tight" style="color: var(--text);">
              {admin ? "Back-Office Ruang Baca" : "Portal Mahasiswa TI"}
            </div>
            <div class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider -mt-0.5">
              Teknik Industri UNIROW Tuban
            </div>
          </div>
        </a>

        <!-- Actions Right -->
        <div class="flex items-center gap-3">
          <!-- Theme Switcher Button -->
          <button
            type="button"
            id="themeToggleBtn"
            onclick="toggleThemeMode()"
            class="h-9 w-9 rounded-xl border flex items-center justify-center text-sm transition-all hover:scale-105"
            style="background: var(--canvas); border-color: var(--border); color: var(--text);"
            title="Ganti Mode Gelap / Terang"
          >
            <span id="themeIcon">🌙</span>
          </button>

          {!admin ? (
            <div class="flex items-center gap-2">
              <a
                href="/login"
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-white transition-all shadow-xs flex items-center gap-1.5"
                style="background: var(--accent);"
              >
                <span>🔑</span>
                <span>Masuk Staf</span>
              </a>
            </div>
          ) : (
            <div class="flex items-center gap-3">
              <div class="hidden sm:block text-right">
                <div class="text-xs font-extrabold" style="color: var(--text);">{currentUser?.nama || 'Petugas'}</div>
                <span class="inline-block px-2 py-0.2 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-700">
                  {currentUser?.role || 'Staff'}
                </span>
              </div>
              <a
                href="/"
                target="_blank"
                class="text-xs font-bold text-indigo-600 hover:text-indigo-700 hidden md:block"
              >
                Lihat Portal Mahasiswa ↗
              </a>
              <a
                href="/api/auth/logout"
                class="h-9 w-9 rounded-xl border border-rose-200 text-rose-600 hover:bg-rose-50 flex items-center justify-center text-xs font-bold"
                title="Keluar Akun"
              >
                🚪
              </a>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t py-6 text-center text-xs text-slate-500 transition-colors"
            style="background: var(--surface); border-color: var(--border);">
      <div class="max-w-7xl mx-auto px-4">
        © 2026 Ruang Baca Program Studi Teknik Industri • Universitas PGRI Ronggolawe (UNIROW) Tuban
      </div>
    </footer>

    <script is:inline>
      function initTheme() {
        const saved = localStorage.getItem('integral_theme') || 'light';
        document.documentElement.setAttribute('data-theme', saved);
        const icon = document.getElementById('themeIcon');
        if (icon) icon.innerText = saved === 'dark' ? '☀️' : '🌙';
      }

      function toggleThemeMode() {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('integral_theme', next);
        const icon = document.getElementById('themeIcon');
        if (icon) icon.innerText = next === 'dark' ? '☀️' : '🌙';
      }

      initTheme();
    </script>
  </body>
</html>
