---
interface Props {
  title?: string;
  description?: string;
  admin?: boolean;
}

const {
  title = 'INTEGRAL - Industrial Integrated Library UNIROW',
  description = 'Sistem Informasi Ruang Baca & Pustaka Terintegrasi Program Studi Teknik Industri UNIROW Tuban',
  admin = false
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo-integral-7.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts: Plus Jakarta Sans & Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">
    <!-- Navigation Bar -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/85 border-b border-slate-200/80 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo Brand -->
        <a href={admin ? "/admin" : "/"} class="flex items-center gap-3 group">
          <img src="/logo-integral-7.png" alt="INTEGRAL Logo" class="h-10 w-auto object-contain transition-transform group-hover:scale-105" />
          <div class="flex flex-col">
            <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-indigo-900 via-blue-800 to-indigo-600 bg-clip-text text-transparent">
              INTEGRAL {admin && <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700 font-semibold ml-1">Workspace</span>}
            </span>
            <span class="text-[10px] font-medium text-slate-500 tracking-wider uppercase -mt-0.5">
              Ruang Baca TI UNIROW Tuban
            </span>
          </div>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-600">
          {!admin ? (
            <>
              <a href="/#katalog" class="hover:text-indigo-600 transition-colors">Katalog Koleksi</a>
              <a href="/#bebas-pustaka" class="hover:text-indigo-600 transition-colors">Bebas Pustaka</a>
              <a href="/#asisten-ai" class="flex items-center gap-1.5 text-indigo-600 hover:text-indigo-700 bg-indigo-50/80 px-3 py-1.5 rounded-full border border-indigo-100">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-600"></span>
                </span>
                Tanya AI Riset
              </a>
              <a href="/login" class="px-4 py-2 rounded-xl bg-slate-900 text-white hover:bg-slate-800 transition-all shadow-sm shadow-slate-900/10 hover:shadow-md">
                Portal Staf
              </a>
            </>
          ) : (
            <>
              <a href="/admin" class="hover:text-indigo-600 transition-colors">Sirkulasi & Data</a>
              <a href="/admin/scanner" class="flex items-center gap-1.5 text-indigo-600 hover:text-indigo-700 bg-indigo-50 px-3 py-1.5 rounded-lg border border-indigo-100 font-medium">
                📷 AI Smart Scanner
              </a>
              <a href="/" target="_blank" class="text-xs text-slate-500 hover:text-slate-800 flex items-center gap-1">
                Lihat Portal Mahasiswa ↗
              </a>
              <a href="/api/auth/logout" class="text-rose-600 hover:text-rose-700 text-xs font-medium">
                Keluar
              </a>
            </>
          )}
        </nav>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-white py-8 mt-16 text-sm text-slate-500">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <img src="/logo-student.png" alt="UNIROW" class="h-6 w-auto opacity-75" />
          <p>© 2026 Program Studi Teknik Industri, Universitas PGRI Ronggolawe Tuban.</p>
        </div>
        <p class="text-xs text-slate-400">
          Powered by Supabase PostgreSQL & Google Gemini AI • Zero Cloud Cost
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }
  .font-editorial {
    font-family: 'Playfair Display', Georgia, serif;
  }
</style>

